					<X>520</X><Y>1020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// solta o lote do fundo 04 (como liberar_wait_lote_linha_09 do T39)
if (wait_fundo_04.size() > 0) {
    wait_fundo_04.free(wait_fundo_04.get(0));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792671400072</Id>
					<Name><![CDATA[fim_ciclo_04e5]]></Name>
					<X>520</X><Y>1040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// vazio ja esta no lote de fundo (recursos liberados no rls_vazio_04e5a/b) -> proximo vagao
ciclo_04e5_ativo = false;
proximo_vagao_04e5();
// linhas 04/05 podem ter acabado -> resto da 3000
tentar_encostar_resto_3000(false);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792674800016</Id>
					<Name><![CDATA[proximo_vagao_04e5]]></Name>
					<X>790</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// solta o proximo vagao para a moega 04 (linha 05 primeiro, depois 04).
// Chamada pelo iniciar_descarga_moegas (fim da manobra) e no fim de cada ciclo (fim_ciclo_04e5).
if (ciclo_04e5_ativo) return;                                          // ciclo em andamento
// sem checar rp_*.idle() aqui. No fim do ciclo o vagao acabou de liberar os recursos
// (rls_vazio_04e5a/b) e o pool ainda aparece ocupado no mesmo instante. Se a manobra estiver
// com o rp_mnb_linha04e5, o vagao espera na fila do sz_descarga_04e5.

boolean da_linha05 = (lote_linha_5 != null);
Trem lote = da_linha05 ? lote_linha_5 : lote_linha_4;
if (lote == null) return;                                               // nada para descarregar

int no_wait = da_linha05 ? wait_lote_linha05.size() : wait_lote_linha04.size();
if (no_wait == 0) {                                                     // lote ainda nao parou na linha
    Log.info("TES", "proximo_vagao_04e5", String.format("espera: lote=%d ainda nao esta no wait da linha %s", lote.getId(), da_linha05 ? "05" : "04"));
    return;
}

fundo_destino_04e5 = get_fundo_destino(lote);
if (fundo_destino_04e5 == 0) {
    Log.warn("TES", "descarga_04e5", String.format("sem espaco nos fundos 05/04, lote=%d parado com %d vagoes",
        lote.getId(), lote.getNumeroDeVagoes()));
    return;
}

ciclo_04e5_ativo = true;
if (da_linha05) wait_lote_linha05.free(wait_lote_linha05.get(0));
else            wait_lote_linha04.free(wait_lote_linha04.get(0));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792675800006</Id>
					<Name><![CDATA[iniciar_descarga_moegas]]></Name>
					<X>790</X><Y>880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// chamada no fim da manobra de encoste (delay_iniciar_descarga), como na ADM.
// Os lotes das linhas 05 e 04 ficam parados nos wait_lote_linha05/04 ate aqui.
// Solta o primeiro vagao para a moega 04; os proximos saem no fim de cada ciclo (fim_ciclo_04e5).
Log.info("TES", "iniciar_descarga_moegas", String.format("lote_linha_5=%s lote_linha_4=%s", lote_linha_5 == null ? "null" : String.valueOf(lote_linha_5.getNumeroDeVagoes()),
    lote_linha_4 == null ? "null" : String.valueOf(lote_linha_4.getNumeroDeVagoes())));
proximo_vagao_04e5();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792680500038</Id>
					<Name><![CDATA[pode_aliviar_linha03]]></Name>
					<X>790</X><Y>920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// a linha 03 so entra no alivio depois que a descarga talhou (o lote esta parado)
return lote_linha_3 != null && talhou_linha03 && lote_linha_3.getNumeroDeVagoesVazios() > 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792680500039</Id>
					<Name><![CDATA[get_excesso_alivio]]></Name>
					<X>790</X><Y>940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// quantos carros do lote que acabou de acoplar ficam na linha (os do fundo).
// Leva so os vazios que faltam para quantidade_alivio; na linha 03 o resto (vazios + carregados) fica.
int pegos_antes = main().getNumeroDeVagoes(trem) - vgs_lote_alivio - qt_vgs_inicio_alivio;
int falta       = Math.max(0, quantidade_alivio - pegos_antes);
int levar       = Math.min(vazios_lote_alivio, falta);
int excesso     = vgs_lote_alivio - levar;
Log.info("TES", "alivio", String.format("falta=%d leva=%d deixa=%d", falta, levar, excesso));
return excesso;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792685300008</Id>
					<Name><![CDATA[retomar_descargas]]></Name>
					<X>790</X><Y>840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// chamada no fim do alivio (rls_alivio).
// Linha 03: o que sobrou do alivio volta para o loop da descarga pelo tem_espaco
// (se nao houver carregados, o tem_espaco manda direto para para_fim_descarga_linha03).
if (wait_retomar_linha03.size() > 0) {
    Trem lote = (Trem) wait_retomar_linha03.get(0);
    int carregados = lote.getNumeroDeVagoesCarregados();
    if (carregados > 0) talhou_linha03 = false;
    Log.info("TES", "retomar_descargas", String.format("linha 03 lote=%d com %d carregados", lote.getId(), carregados));
    wait_retomar_linha03.free(lote);
}
// Moega 04: se a descarga 04/05 tinha parado sem espaco nos fundos, volta agora
proximo_vagao_04e5();
// o alivio pode ter esvaziado a linha 03 e o fundo 04 -> resto da 3000
tentar_encostar_resto_3000(true);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792698800016</Id>
					<Name><![CDATA[tentar_encostar_resto_3000]]></Name>
					<X>790</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mostrar_trace]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[// o lote novo da 3000 tem prioridade: é ele que ocupa as linhas primeiro
tentar_encostar_novo_lote_3000(mostrar_trace);

// solta o resto da 3000 (com as locos FIPS na cauda) para o encoste das linhas 03/04/05
// quando os lotes do primeiro encoste ja sairam: linha 03 aliviada, linhas 04 e 05 descarregadas
// e o fundo 04 (mesmo espaco da linha 04) aliviado. O fundo 05 fica em outra track.
if (wait_resto_3000.size() == 0) return;

boolean linhas_livres = lote_linha_3 == null && lote_linha_4 == null
                     && lote_linha_04_fundo == null && lote_linha_5 == null;
if (!linhas_livres) {
    if (mostrar_trace)
        Log.info("TES", "resto_3000", String.format("espera: linha03=%d linha04=%d fundo04=%d linha05=%d", main().getTamanhoDoTrem(lote_linha_3), main().getTamanhoDoTrem(lote_linha_4),
            main().getTamanhoDoTrem(lote_linha_04_fundo), main().getTamanhoDoTrem(lote_linha_5)));
    return;
}

Trem resto = (Trem) wait_resto_3000.get(0);
Log.info("TES", "resto_3000", String.format("lote=%d sai da 3000 para o encoste", resto.getId()));
// a MRS (82 vagoes) nao cabe numa manobra (24+12+11) e volta para a 3000 -> a 3000 continua dela
if (resto.getNumeroDeVagoes() <= 47) lote_linha3000_emDescarga = null;
atualizar_licenciamento_linha3000(resto);
wait_resto_3000.free(resto);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000030</Id>
					<Name><![CDATA[tentar_encostar_novo_lote_3000]]></Name>
					<X>790</X><Y>950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mostrar_trace]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[// solta o 1º lote do trem novo (parado na 3000) para o encoste das linhas 03/04/05
// só com as linhas livres e sem outro encoste em andamento (ex.: o resto do trem anterior)
if (wait_encoste_3000.size() == 0) return;

boolean linhas_livres = lote_linha_3 == null && lote_linha_4 == null
                     && lote_linha_04_fundo == null && lote_linha_5 == null;
if (!linhas_livres || trem_em_encoste != null) {
    if (mostrar_trace)
        Log.info("TES", "novo_lote_3000", String.format("espera: linha03=%d linha04=%d fundo04=%d linha05=%d em_encoste=%b", main().getTamanhoDoTrem(lote_linha_3), main().getTamanhoDoTrem(lote_linha_4),
            main().getTamanhoDoTrem(lote_linha_04_fundo), main().getTamanhoDoTrem(lote_linha_5), trem_em_encoste != null));
    return;
}

Trem lote = (Trem) wait_encoste_3000.get(0);
Log.info("TES", "novo_lote_3000", String.format("lote=%d sai da 3000 para o encoste", lote.getId()));
wait_encoste_3000.free(lote);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798200000301</Id>
					<Name><![CDATA[terminal_vazio]]></Name>
					<X>40</X><Y>1060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// sem trem chegando, sem lote na 3000, sem encoste e sem vagões (carregados ou vazios) no terminal
return _trem_chegando == null
    && lote_linha3000_emDescarga == null
    && lote_linha3000_proximo == null
    && trem_em_encoste == null
    && wait_encoste_3000.size() == 0
    && _getVagoesCarregados() == 0
    && _getVagoesVazios() == 0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798200000441</Id>
					<Name><![CDATA[eh_mesmo_tipo_em_atendimento]]></Name>
					<X>40</X><Y>1080</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// compara o 1º vagão do trem com a ferrovia/segmento em atendimento
for (int i = 0; i < trem.size(); i++) {
    Agent carro = trem.getCar(i);
    if (carro instanceof Vagao) {
        Vagao v = (Vagao) carro;
        return java.util.Objects.equals(v.ferrovia, getFerrovia())
            && java.util.Objects.equals(v.segmento, getSegmento());
    }
}
return false;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798200000707</Id>
					<Name><![CDATA[lote_txt]]></Name>
					<X>3950</X><Y>100</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) return "-";
return t.getId() + ":" + main().getNumeroDeVagoes(t);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798200000708</Id>
					<Name><![CDATA[estado_resumo]]></Name>
					<X>3950</X><Y>140</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return String.format("vz=%d cg=%d ov=%.2f moega=%s", _getVagoesVazios(), _getVagoesCarregados(), getOverloadVazios(),
    "03=" + (rp_moega03.idle() > 0 ? "livre" : "ocupada") + " 04=" + (rp_moega04.idle() > 0 ? "livre" : "ocupada"));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000709</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>3950</X><Y>180</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("TES", evento, t + " | " + msg + " | " + estado_resumo());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000710</Id>
					<Name><![CDATA[log_estado]]></Name>
					<X>3950</X><Y>220</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// snapshot do terminal para o log de análise (idle/busy dos pools, tamanho dos waits)
if (!log_de_analise) return;
Log.info("TES", "estado", estado_resumo());
Log.info("TES", "estado_lotes", "lote_linha3000_emDescarga=" + lote_txt(lote_linha3000_emDescarga) +
    " lote_linha3000_proximo=" + lote_txt(lote_linha3000_proximo) +
    " lote_linha_3=" + lote_txt(lote_linha_3) +
    " lote_linha_4=" + lote_txt(lote_linha_4) +
    " lote_linha_5=" + lote_txt(lote_linha_5) +
    " lote_linha_03_fundo=" + lote_txt(lote_linha_03_fundo) +
    " lote_linha_04_fundo=" + lote_txt(lote_linha_04_fundo) +
    " lote_linha_05_fundo=" + lote_txt(lote_linha_05_fundo) +
    " _trem_chegando=" + lote_txt(_trem_chegando));
Log.info("TES", "estado_pools", "linha3000_lote_em_descarga=" + linha3000_lote_em_descarga.idle() + "/" + linha3000_lote_em_descarga.busy() +
    " rp_moega04=" + rp_moega04.idle() + "/" + rp_moega04.busy() +
    " rp_moega03=" + rp_moega03.idle() + "/" + rp_moega03.busy() +
    " rp_mnb_linha03=" + rp_mnb_linha03.idle() + "/" + rp_mnb_linha03.busy() +
    " rp_mnb_linha04e5=" + rp_mnb_linha04e5.idle() + "/" + rp_mnb_linha04e5.busy());
Log.info("TES", "estado_waits", "wait_lote_linha04=" + wait_lote_linha04.size() +
    " wait_lote_linha05=" + wait_lote_linha05.size() +
    " wait_fundo_05=" + wait_fundo_05.size() +
    " wait_fundo_04=" + wait_fundo_04.size() +
    " wait_retomar_linha03=" + wait_retomar_linha03.size() +
    " wait_resto_3000=" + wait_resto_3000.size() +
    " wait_encoste_3000=" + wait_encoste_3000.size());]]></Body>
				</Function>
			</Functions>

