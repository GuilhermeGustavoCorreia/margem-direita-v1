						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-103: coperXI/costaLeite pegam a via2_e e as faixas da manobra (marginal_a/b/c, intervalo4000_a/b) de uma vez.
// Antes a via2_e era licenciada no início da via3_b e as marginais só no terminal: com um vazio na marginal
// esperando a via2_e, os dois travavam. Quem solta as marginais é o terminal (CoperXI: pst_marginal_liberar;
// CostaLeite: liberar_marginal_encoste); a via2_e sai pelo caminho normal (liberar_faixas_ocupadas).
Trem t = (Trem) agent;
faixa_via2_e.licenciar(t);
faixa_marginal_a.bloquear(t);
faixa_marginal_b.bloquear(t);
faixa_marginal_c.bloquear(t);
faixa_intervalo4000_a.bloquear(t);
faixa_intervalo4000_b.bloquear(t);
main().railwaySwitch73.connectTracks(main().pst_marginal_a, main().pst_marginal_b);]]></Code>
							</Value>
						</Parameter>
