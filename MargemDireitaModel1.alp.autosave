				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787855172665</Id>
					<Name><![CDATA[devolver_saldoLocomotiva]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>390</X><Y>1050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
    Locomotiva locomotiva = (Locomotiva) trem.getCar(i);
    String patio = locomotiva.patio;

    switch (patio) {

        case "pst":
            pst_locomotivas_disponiveis = (pst_locomotivas_disponiveis + 1);
            break;

        case "pmc":
            pmc_locomotivas_disponiveis = (pmc_locomotivas_disponiveis + 1);
            break;

        case "pcx":
            pcx_locomotivas_disponiveis = (pcx_locomotivas_disponiveis + 1);
            break;

        default:
            error("PATIO DESCONHECIDO: " + patio);
            break;
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789181593937</Id>
					<Name><![CDATA[solicitar_locomotiva]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>100</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[patio]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destino]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Train trem = null;

switch (patio) {
    case "PSN":
        trem = trainSource1.inject();
        break;
    case "PMC":
        trem = trainSource2.inject();
        break;
    case 2"PCX":
        trem = trainSource3.inject();
        break;
    default:
        error("Valor não reconhecido para injeção de trem: " + valor);
        break;
}

if (trem != null) {
    trem.desino = valorDoAtributo;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789654352597</Id>
					<Name><![CDATA[verificar_ferrovia_da_locomotiva]]></Name>
					<X>700</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Agent primeiroCarro = trem.getFirst();

if (primeiroCarro instanceof Locomotiva) {
    
    Locomotiva loco = (Locomotiva) primeiroCarro;
    return loco.ferrovia.equalsIgnoreCase(ferrovia);
    
} else {

    traceln("erro: carro não é locomotiva");
    return false;
    
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789664284000</Id>
					<Name><![CDATA[solicitar_locomotivas_manobra]]></Name>
					<X>670</X><Y>160</Y>
					<Label><X>12</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[patio]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("chamando locomotiva de manobra");

switch (patio) {

    case "pst":
        if (tipo.equals("manobra-coperXI-rechego")) {
            //locoFips_pst_mnb_coperXI.inject();
            
            traceln("dkfnALIEFNÃPIN");
        } else {
            error("Tipo de manobra desconhecido no PST: [" + tipo + "]");
        }
        break;

    default:
        error("PATIO DESCONHECIDO: [" + patio + "] len=" + patio.length());
        break;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790089120221</Id>
					<Name><![CDATA[verificar_patio_da_locomotiva]]></Name>
					<X>1390</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[patio]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Agent primeiroCarro = trem.getFirst();

if (primeiroCarro instanceof Locomotiva) {
    
    Locomotiva loco = (Locomotiva) primeiroCarro;
    return loco.patio.equalsIgnoreCase(patio);
    
} else {

    traceln("erro: carro não é locomotiva");
    return false;
    
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool]]></ReturnType>
					<Id>1790779134818</Id>
					<Name><![CDATA[selecionar_rp_locomotiva_trecho]]></Name>
					<X>670</X><Y>140</Y>
					<Label><X>12</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("chamando locomotiva de trecho");

if (ferrovia == null)
    error("FERROVIA NULA");

switch (ferrovia.trim().toLowerCase()) {

    case "rumo":
        return rp_locoRumo;

    case "mrs":
        return rp_locoMRS;

    case "vli":
        return rp_locoVLI;

    default:
        error("FERROVIA DESCONHECIDA: [" + ferrovia + "] len=" + ferrovia.length());
        return null;
}]]></Body>
				</Function>
