							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("liberar_faixas_loco_alivio", agent, "soltou");
// ALT-063: faixas do caminho da loco voltam a ficar livres
for (Faixa f : primeiro_alivio_faixas) {
	if (f != null && f.idTremLicenciado == 9999) f.liberar();
}]]></Code>
							</Value>
