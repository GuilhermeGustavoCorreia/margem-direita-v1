				<EmbeddedObject>
					<Id>1787583156291</Id>
					<Name><![CDATA[gestorDeLocomotivas]]></Name>
					<X>650</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
