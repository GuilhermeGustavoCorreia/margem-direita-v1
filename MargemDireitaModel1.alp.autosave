				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784557361378</Id>
					<Name><![CDATA[sistema_semaforo]]></Name>
					<X>740</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[sinal]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch (sinal) {

    case "descarregar":
        _aguardaDescarregar = true;
        _aguardaColocar     = false;
        _aguardaAliviar     = false;
        break;

    case "colocar":
        _aguardaDescarregar = false;
        _aguardaColocar     = true;
        _aguardaAliviar     = false;
        break;

    case "aliviar":
        _aguardaDescarregar = false;
        _aguardaColocar     = false;
        _aguardaAliviar     = true;
        break;

    case "livre":
        _aguardaDescarregar = false;
        _aguardaColocar     = false;
        _aguardaAliviar     = false;
        break;
        
    case "all-blocj":
        _aguardaDescarregar = true;
        _aguardaColocar     = true;
        _aguardaAliviar     = true;
        break;
    

    default:
        error("Sinal desconhecido no sistema_semaforo: " + sinal);
        break;
}

aguardaDescarregar.recalculateConditions();
aguardaColocar.recalculateConditions();
aguardaAliviar.recalculateConditions();]]></Body>
				</Function>
