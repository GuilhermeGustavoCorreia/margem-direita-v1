				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788188469793</Id>
					<Name><![CDATA[podeReceberNovoLote]]></Name>
					<X>-325</X><Y>230</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// trem entrando ou descarregando: do encoste até o 1º lote de vazios
if (_trem_chegando != null) return false;
if (_getVagoesCarregados() > 0) return false;
// vazios no terminal (esperando ou em alívio)
return _getVagoesVazios() == 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[PositionOnTrack ]]></ReturnType>
					<Id>1788196178875</Id>
					<Name><![CDATA[getPosicaoUltimoVagao]]></Name>
					<X>610</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[offsetCrescenteParaAtras]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[Agent ultimoVagao = trem.getLast();
if (ultimoVagao == null) {
    error("Trem vazio.");
    return;
}

try {
    java.lang.reflect.Method mTrack = ultimoVagao.getClass().getMethod("getTrack", boolean.class);
    java.lang.reflect.Method mOffset = ultimoVagao.getClass().getMethod("getOffset", boolean.class);

    _trackAparecerLocoMnb = (RailwayTrack) mTrack.invoke(ultimoVagao, false);
    double offsetUltimoVagao = (double) mOffset.invoke(ultimoVagao, false);

    _offsetAparecerLocoMnb = offsetCrescenteParaAtras ? offsetUltimoVagao + 20 : offsetUltimoVagao - 20;
    _offsetAparecerLocoMnb = Math.max(0, Math.min(_offsetAparecerLocoMnb, _trackAparecerLocoMnb.length(METER)));

} catch (Exception e) {
    error("Erro ao calcular posição do último vagão: " + e.getMessage());
}]]></Body>
				</Function>
