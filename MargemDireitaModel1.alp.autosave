				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1782845989180</Id>
					<Name><![CDATA[getLoteAtendimento_efetivo]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1440</X><Y>-6790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[Vagao primeiroVagao = trem.getPrimeiroVagao();

int numero_de_vagoes = trem.size();

String moega 		= primeiroVagao.moegaDestino;

int loteEmVagoes 	= getLoteAtendimento_nominal(moega);
trem.posicaoDeCorte = loteEmVagoes;

return (loteEmVagoes > numero_de_vagoes) ? numero_de_vagoes : loteEmVagoes ;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1782846039922</Id>
					<Name><![CDATA[getLoteAtendimento_nominal]]></Name>
					<X>1840</X><Y>-6790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[moega]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[List<Number> valores = selectValues(
    Number.class,
    "SELECT lote_atendimento FROM parametros_terminais WHERE moega = ?",
    moega
);

if (valores.isEmpty()) {
    error("Moega não encontrada em parametros_terminais: " + moega);
    return 0;
}

return valores.get(0).intValue();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782992207626</Id>
					<Name><![CDATA[getDestinoLogica]]></Name>
					<X>1840</X><Y>-6810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[moega]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    List<String> agentes = selectValues(
        String.class,
        "SELECT agente FROM parametros_terminais WHERE moega = ?",
        moega
    );

    List<String> blocos = selectValues(
        String.class,
        "SELECT atendimento FROM parametros_terminais WHERE moega = ?",
        moega
    );

    if (agentes.isEmpty() || blocos.isEmpty()) {
        error("Moega não encontrada em parametros_terminais: " + moega);
        return;
    }

    String nomeAgente = agentes.get(0);
    String nomeBlocoEnter = blocos.get(0);

    // 1. Busca o campo do agente (ex: CliMar) dentro de Main
    java.lang.reflect.Field campoAgente = Main.class.getDeclaredField(nomeAgente);
    campoAgente.setAccessible(true);
    Object blocoAgente = campoAgente.get(this);

    // 2. Busca o campo do bloco Enter (ex: cliMar_atendimento) dentro do agente
    java.lang.reflect.Field campoEnter = blocoAgente.getClass().getDeclaredField(nomeBlocoEnter);
    campoEnter.setAccessible(true);
    Object blocoEnter = campoEnter.get(blocoAgente);

    // 3. Chama o método take(agent) nesse bloco Enter
    java.lang.reflect.Method metodoTake = blocoEnter.getClass().getMethod("take", Agent.class);
    metodoTake.invoke(blocoEnter, agent);

} catch (Exception e) {
    error("Erro ao rotear atendimento para moega '" + moega + "': " + e.getMessage());
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783949206630</Id>
					<Name><![CDATA[getAgenteMoega]]></Name>
					<X>1840</X><Y>-6830</Y>
					<Label><X>11</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[moega]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {
    
    List<String> agentes = selectValues(
        String.class,
        "SELECT agente FROM parametros_terminais WHERE moega = ?",
        moega
    );

    String nomeAgente = agentes.get(0);
 	
 	return nomeAgente;
 	
} catch (Exception e) {
    error("Erro ao rotear atendimento para moega '" + moega + "': " + e.getMessage());
	return null;
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object]]></ReturnType>
					<Id>1783950130657</Id>
					<Name><![CDATA[getBlocoPeloNome]]></Name>
					<Description><![CDATA[Busca, via reflection, o valor de um campo (variável, elemento ou bloco) dentro de um objeto container, a partir do nome do campo em texto.

Parâmetros:
- nomeBloco: nome exato do campo a ser localizado (deve corresponder ao nome do elemento no diagrama, com maiúsculas/minúsculas idênticas).
- container: objeto onde o campo será procurado (ex: Main, ou uma instância de agente).

Retorno: o objeto encontrado (tipo Object, requer cast no ponto de uso), ou null se o campo não existir ou não for acessível.

Uso típico: localizar dinamicamente agentes ou blocos (ex: Enter, Queue) cujo nome vem de uma tabela do banco de dados, evitando escrever um "if/else" para cada caso.

Limitação: só encontra campos declarados diretamente na classe do container — não busca em superclasses.]]></Description>
					<X>1840</X><Y>-6768</Y>
					<Label><X>11</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nomeBloco]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[container]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    java.lang.reflect.Field campo = container.getClass().getDeclaredField(nomeBloco);
    campo.setAccessible(true);

    return campo.get(container);

} catch (Exception e) {

    error("Erro ao buscar campo '" + nomeBloco + "' em "
        + container.getClass().getSimpleName() + ": " + e.getMessage());
    return null;
}]]></Body>
				</Function>
