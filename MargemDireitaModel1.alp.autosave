						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[for (Object t : getAllOccupiedTracks()) {

    com.anylogic.engine.markup.RailwayTrack track =
        (com.anylogic.engine.markup.RailwayTrack) t;

    if (track == linha) {
        return true;
    }
}

return false;]]></Body>
