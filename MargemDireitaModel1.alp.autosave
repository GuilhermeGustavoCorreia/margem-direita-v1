							<Value Class="CodeValue">
								<Code><![CDATA[if (agent instanceof Trem) {
	_selecionarTamanhoDoLote((Trem) agent);
	_tamanhoLotePera = _contarVagoes(((Trem) agent));
	
} else {
	error("Tipo inesperado em colocarLoteNaMoega: " + agent.getClass().getSimpleName());
}

// ALT-003: ferrovia/produto em atendimento (indicadores e ITerminalMoega)
if (agent instanceof Trem) {
	Vagao v = ((Trem) agent).getPrimeiroVagao();
	if (v != null) {
		ferrovia_em_atendimento = v.ferrovia;
		produto_em_atendimento  = v.segmento;
	}
}]]></Code>
