			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792518752491</Id>
					<Name><![CDATA[atualizarFerroviaEProdutoEmAtendimento]]></Name>
					<X>40</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i); // confere o nome exato do método com Ctrl+Espaço

        if (carro instanceof Vagao) {
            Vagao vagao = (Vagao) carro;
            ferrovia_em_atendimento = vagao.ferrovia;
            segmento_em_atendimento = vagao.segmento;
            return; // achou o primeiro vagão, encerra
        }
    }

    Log.erro("TES", "trem_sem_vagao", "trem não tem nenhum vagão");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792518896288</Id>
					<Name><![CDATA[_getVagoesVazios]]></Name>
					<X>40</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[

int vazios_linha_03	= lote_linha_3 != null ? lote_linha_3.getNumeroDeVagoesVazios() : 0;
int vazios_linha_04	= main().getNumeroDeVagoes(lote_linha_04_fundo);
int vazios_linha_05	= main().getNumeroDeVagoes(lote_linha_05_fundo);

return (

	vazios_linha_03 +
	vazios_linha_04 +
	vazios_linha_05
	
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792518896291</Id>
					<Name><![CDATA[_getVagoesCarregados]]></Name>
					<X>40</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// lote parado esperando as linhas liberarem (resto no wait_resto_3000 ou novo lote no
// wait_encoste_3000) nao conta; senao o alivio dos ultimos vazios nunca e forcado
boolean resto_esperando = wait_resto_3000.size() > 0 && wait_resto_3000.get(0) == lote_linha3000_emDescarga;
boolean novo_esperando  = wait_encoste_3000.size() > 0;
int vagoes_linha_3000_emDescarga = (resto_esperando || novo_esperando) ? 0 : main().getNumeroDeVagoes(lote_linha3000_emDescarga);
int vagoes_linha_3000_proximo 	 = main().getNumeroDeVagoes(lote_linha3000_proximo);

int vagoes_linha_03				 = lote_linha_3 != null? lote_linha_3.getNumeroDeVagoesCarregados() : 0;
int vagoes_linha_04				 = main().getNumeroDeVagoes(lote_linha_4);
int vagoes_linha_05				 = main().getNumeroDeVagoes(lote_linha_5); 

return (
	vagoes_linha_3000_emDescarga + 
	vagoes_linha_3000_proximo + 
	vagoes_linha_03 +
	vagoes_linha_04 +
	vagoes_linha_05 +
	main().getNumeroDeVagoes(trem_em_encoste)   // carregados em manobra
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
