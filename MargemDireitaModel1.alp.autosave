								<Code><![CDATA[log_mov("etapa:deixarTerminal", agent);
// ALT-022
// fim do alívio, descarga pode voltar
fazendoAlivio = false;
// vazios que nao couberam nas linhas cheias esperam no wait: com as linhas livres, tentam de novo
Log.info("CostaLeite", "soltou_wait", "soltando " + wait.size() + " | " + texto_estado());
wait.freeAll();   // free() so agenda a saida: um while (size > 0) nunca termina
atualiza_vaiDescarga();]]></Code>
							</Value>
