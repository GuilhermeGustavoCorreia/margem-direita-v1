				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792519768494</Id>
					<Name><![CDATA[atualizar_licenciamento_linha3000]]></Name>
					<X>520</X><Y>840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// a 3000 fica ocupada enquanto houver lote nela ou a caminho.
// Antes olhava se havia trem fisicamente na track: no onEnter o trem ainda nao chegou e a faixa era liberada.
Faixa faixa_linha_3000_a = main().gestorDeCirculacao.faixa_linha3000_a;

boolean tem_lote_linha_3000 = (lote_linha3000_emDescarga != null || lote_linha3000_proximo != null);

if (tem_lote_linha_3000) {
    faixa_linha_3000_a.ocupar(trem);
} else {
    faixa_linha_3000_a.liberar();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792521700042</Id>
					<Name><![CDATA[eh_trem_rumo]]></Name>
					<X>520</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// true se o primeiro vagao do trem for da Rumo
for (int i = 0; i < trem.size(); i++) {
    Agent carro = trem.getCar(i);
    if (carro instanceof Vagao) {
        return "rumo".equals(((Vagao) carro).ferrovia);
    }
}
return false;]]></Body>
				</Function>
