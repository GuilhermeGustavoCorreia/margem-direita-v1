						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[int contador = 0;

for (int i = 0; i < trem.size(); i++) {

    Agent vagao = trem.getCar(i);

    if (!(vagao instanceof Locomotiva)) {
        contador++;
    }
}

return contador;]]></Body>
