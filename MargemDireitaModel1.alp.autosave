				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1782267899505</Id>
					<Name><![CDATA[getVagosNaLinha]]></Name>
					<Description><![CDATA[Este era pra versão sem a pera]]></Description>
					<X>1520</X><Y>-7460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[track]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[int totalVagoes = 0;

com.anylogic.engine.markup.RailwayTrack linha =
    (com.anylogic.engine.markup.RailwayTrack) track;

for( Agent a : linha.getTrains() ){
    if( a instanceof Trem ){
        totalVagoes += ((Trem) a).getNumeroDeVagoes();
    }
}

return totalVagoes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782498772574</Id>
					<Name><![CDATA[getDestinoDoTrem]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1440</X><Y>-6650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[train]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[if (train == null) return null;

int n = 0;
try {
    
    while (train.getCar(n) != null) {
        
        Agent car = train.getCar(n);
        
        if (car instanceof Vagao) {
        	
            return ((Vagao) car).moegaDestino;
            
        }
        n++;
    }
} catch (Exception e) {}

return null;]]></Body>
				</Function>
