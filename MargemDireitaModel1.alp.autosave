								<Code><![CDATA[
((Trem) agent).faixa_atual   = faixa_marginal_c;


((Trem) agent).proxima_faixa = 		"bracell".equals(((Trem) agent).get_terminal_name()) ? faixa_intervalo4000_a
                             : (	"suzano".equals(((Trem) agent).get_terminal_name())||
                             		"eldorado".equals(((Trem) agent).get_terminal_name()))  ? faixa_linha6000_a : null;

if (trace_circulacao) Log.info("GesCirculacao", "exit_para_marginal_c", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));
tentar_usar_faixa.take(agent);]]></Code>
							</Value>
