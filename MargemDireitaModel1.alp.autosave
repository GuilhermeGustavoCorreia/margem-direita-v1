					</Parameter>
					<Body><![CDATA[List<Number> valores = selectValues(
    Number.class,
    "SELECT lote_atendimento FROM parametros_terminais WHERE moega = ?",
    moega
);

if (valores.isEmpty()) {
    error("Moega não encontrada em parametros_terminais: " + moega);
    return 0;
}

return valores.get(0).intValue();]]></Body>
