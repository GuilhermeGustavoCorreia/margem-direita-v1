					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int vazios_linhaMar_MEIO = main().getTamanhoDoTrem(_loteVazios_meio);
int vazios_linhaMar_L4 	 = main().getTamanhoDoTrem(_loteVazios_L4);

