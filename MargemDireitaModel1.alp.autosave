					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1782845989180</Id>
					<Name><![CDATA[getLoteAtendimento_efetivo]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1440</X><Y>-6790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[Vagao primeiroVagao = trem.getPrimeiroVagao();

int numero_de_vagoes = trem.size();

String moega 		= primeiroVagao.moegaDestino;

int loteEmVagoes 	= getLoteAtendimento_nominal(moega);
trem.posicaoDeCorte = loteEmVagoes;

return (loteEmVagoes > numero_de_vagoes) ? numero_de_vagoes : loteEmVagoes ;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
