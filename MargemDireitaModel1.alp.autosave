							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("fim_descarga_L1", agent, "saiu");
// ALT-059: fim da descarga da L1
lote_carregados_L1 = null;
if (!em_troca) {
	// 1a rodada (40): os vazios esperam a loco FIPS para a troca
	aguardar_troca_L1.take(agent);
	registrar_linha_descarregada();
} else {
	// 2a rodada (24 da troca): os vazios ficam na linha para o alívio
	loteVazios_L1 = (Trem) agent;
	verificar_descarregou_tudo();
}]]></Code>
							</Value>
						</Parameter>
