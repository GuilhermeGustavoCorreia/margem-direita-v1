((Trem) agent).faixa_atual   = faixa_via3_c;
((Trem) agent).proxima_faixa = faixa_via3_d;
if (trace_circulacao) Log.info("GesCirculacao", "exit_para_via3_c", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));

tentar_usar_faixa.take(agent);]]></Code>
