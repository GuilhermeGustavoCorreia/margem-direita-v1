					<Body><![CDATA[if (main().wait.size() > 0 ) {

	for (int i = 0; i < main().wait.size(); i++) {
		
	    Trem train = (Trem) main().wait.get(i);
	    String moegaDestinoDoTrem = main().getDestinoDoTrem(train);
	
	    if (moegaDestino.equals(moegaDestinoDoTrem)) {
	        traceln("return true");
	        return true;
	    }
	}
}

return false;
]]></Body>
