				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790883461898</Id>
					<Name><![CDATA[trem_possui_locomotiva]]></Name>
					<X>200</X><Y>1560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[train]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[boolean temLoco = false;
for (int i = 0; i < train.size(); i++) {
    Agent carro = train.getCar(i);
    if (carro instanceof Locomotiva && !((Locomotiva) carro).de_tracao) {
        temLoco = true;
        break;
    }
}

return temLoco;]]></Body>
				</Function>
