				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795095187625</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>90</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("TEC", evento, t + " | " + msg);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RailwayTrack]]></ReturnType>
					<Id>1798310000029</Id>
					<Name><![CDATA[get_track_cauda]]></Name>
					<X>-160</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// trilho da traseira do último vagão do trem parado no _tec_encoste
Agent ultimo = _trem_chegando.getLast();
try {
	return (RailwayTrack) ultimo.getClass().getMethod("getTrack", boolean.class).invoke(ultimo, false);
} catch (Exception e) {
	error("TEC get_track_cauda: " + e);
	return null;
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798310000030</Id>
					<Name><![CDATA[get_offset_cauda]]></Name>
					<X>-160</X><Y>920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// cabeça da loco que entra na cauda (TrainEnter na orientação padrão: a loco fica entre offset - comprimento e offset).
// trem andando no sentido do trilho (traseira no menor offset): cabeça da loco na traseira do vagão.
// trem andando contra o sentido do trilho: cabeça da loco um comprimento de loco depois da traseira.
double[] info = get_ultimo_carro_info();
double frente = info[0], tras = info[1];
double comp_loco = 22.5; // locos de 22,5 m (formações de teste)
double offset = (frente > tras) ? tras : tras + comp_loco;
Log.info("TEC", "loco_cauda", String.format("trilho=%s frente=%.1f tras=%.1f offset_loco=%.1f", get_track_cauda().getName(), frente, tras, offset));
return offset;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1798310000031</Id>
					<Name><![CDATA[get_ultimo_carro_info]]></Name>
					<X>-160</X><Y>940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// {offset da frente, offset da traseira} do último vagão, no trilho da traseira
Agent ultimo = _trem_chegando.getLast();
try {
	java.lang.reflect.Method mo = ultimo.getClass().getMethod("getOffset", boolean.class);
	double frente = (double) mo.invoke(ultimo, true);
	double tras   = (double) mo.invoke(ultimo, false);
	return new double[] { frente, tras };
} catch (Exception e) {
	error("TEC get_ultimo_carro_info: " + e);
	return new double[] { 0, 0 };
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795098515817</Id>
					<Name><![CDATA[atualizarFerroviaEProdutoEmAtendimento]]></Name>
					<X>100</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i); // confere o nome exato do método com Ctrl+Espaço

        if (carro instanceof Vagao) {
            Vagao vagao = (Vagao) carro;
            ferrovia_em_atendimento = vagao.ferrovia;
            segmento_em_atendimento = vagao.segmento;
            return; // achou o primeiro vagão, encerra
        }
    }

    Log.erro("ADM", "trem_sem_vagao", "trem não tem nenhum vagão");]]></Body>
				</Function>
			</Functions>

