							<Value Class="CodeValue">
								<Code><![CDATA[if (car instanceof Vagao) {

    ((Vagao) car).setSegmento("celulose");
    ((Vagao) car).setFerrovia("rumo"); 
	((Vagao) car).setTerminal(main().suzano); // ALT-057: era costaLeite

} else if (car instanceof Locomotiva) {
    ((Locomotiva) car).ferrovia = "rumo";
}]]></Code>
