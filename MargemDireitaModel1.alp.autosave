				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792958885238</Id>
					<Name><![CDATA[podeReceberNovoLote]]></Name>
					<X>-325</X><Y>230</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Suzano e Eldorado não atendem ao mesmo tempo: o lote de 24 da Suzano fica na 6000_d,
// caminho obrigatório do Eldorado (6000_c -> 6000_d -> 6000_e -> 6000_f)
return !terminal_ocupado() && !main().suzano.terminal_ocupado();]]></Body>
				</Function>
