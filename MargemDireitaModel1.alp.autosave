					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qt_fracao]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int numero_de_vagoes = trem.size();

return (qt_fracao > numero_de_vagoes) ? numero_de_vagoes : qt_fracao ;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
