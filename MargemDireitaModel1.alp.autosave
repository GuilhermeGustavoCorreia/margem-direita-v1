				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789654352597</Id>
					<Name><![CDATA[verificar_ferrovia_da_locomotiva]]></Name>
					<X>700</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Agent primeiroCarro = trem.getFirst();

if (primeiroCarro instanceof Locomotiva) {
    
    Locomotiva loco = (Locomotiva) primeiroCarro;
    return loco.ferrovia.equalsIgnoreCase(ferrovia);
    
} else {

    Log.erro("GesLocomotivas", "carro_nao_e_locomotiva", "carro não é locomotiva");
    return false;
    
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789664284000</Id>
					<Name><![CDATA[solicitar_locomotivas_manobra]]></Name>
					<X>670</X><Y>160</Y>
					<Label><X>12</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[patio]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Log.info("GesLocomotivas", "solicitar_loco_manobra", "chamando locomotiva de manobra");

switch (patio) {

    case "pst":
        if (tipo.equals("manobra-coperXI-rechego")) {
            
            Log.debug("GesLocomotivas", "debug_temporario", "dkfnALIEFNÃPIN");
            
        } else {
            error("Tipo de manobra desconhecido no PST: [" + tipo + "]");
        }
        break;

    default:
        error("PATIO DESCONHECIDO: [" + patio + "] len=" + patio.length());
        break;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790089120221</Id>
					<Name><![CDATA[verificar_patio_da_locomotiva]]></Name>
					<X>1390</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[patio]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Agent primeiroCarro = trem.getFirst();

if (primeiroCarro instanceof Locomotiva) {
    
    Locomotiva loco = (Locomotiva) primeiroCarro;
    return loco.patio.equalsIgnoreCase(patio);
    
} else {

    Log.erro("GesLocomotivas", "carro_nao_e_locomotiva", "carro não é locomotiva");
    return false;
    
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool]]></ReturnType>
					<Id>1790779134818</Id>
					<Name><![CDATA[selecionar_rp_locomotiva_trecho]]></Name>
					<X>670</X><Y>140</Y>
					<Label><X>12</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Log.info("GesLocomotivas", "solicitar_loco_trecho", "chamando locomotiva de trecho");

if (ferrovia == null)
    error("FERROVIA NULA");

switch (ferrovia.trim().toLowerCase()) {

    case "rumo":
        return rp_locoRumo;

    case "mrs":
        return rp_locoMRS;

    case "vli":
        return rp_locoVLI;

    default:
        error("FERROVIA DESCONHECIDA: [" + ferrovia + "] len=" + ferrovia.length());
        return null;
}]]></Body>
				</Function>
