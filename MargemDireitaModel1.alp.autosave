					<Body><![CDATA[StringBuilder sb = new StringBuilder();
for (ITerminalMoega t : terminais_pcx) {
    sb.append(((Agent) t).getName())
      .append(": ")
      .append(String.format("%.2f", t.getOverloadVazios()))
      .append("\n");
}
return sb.toString();]]></Body>
