					<X>840</X><Y>-7220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tracks]]></Name>
						<Type><![CDATA[RailwayTrack[]]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.HashSet<Object> carrosContados = new java.util.HashSet<Object>();

for (RailwayTrack track : tracks) {
	
	if (track == null) {
		continue;
	}
	
	carrosContados.addAll(track.getCars());
}

return carrosContados.size();]]></Body>
