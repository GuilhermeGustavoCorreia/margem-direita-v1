						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// loco de alívio: prefixo MNB + número ímpar
contador_mnb = (contador_mnb >= 99) ? 1 : contador_mnb + 2;
((Trem) agent).prefixo = String.format("MNB%02d", contador_mnb);

// ocupa a faixa onde a loco é criada com o id dela; a circulação libera quando o trem de volta sair
Faixa fc = alivio_em_andamento_pst.faixa_criacao;
if (fc != null) {
    fc.ocupar((Trem) agent);
    Log.info("GesAlivios", "diag_pst", String.format("loco do alivio (%s - %d) ocupa %s", ((Trem) agent).prefixo, agent.getId(), fc.recurso.getName()));
}

// faixas de circulação em que o trem pode entrar durante o alívio (apreendidas no mesmo conjunto)
for (Faixa f : alivio_em_andamento_pst.get_faixas_saida()) {
    f.ocupar((Trem) agent);
    Log.info("GesAlivios", "diag_pst", String.format("loco do alivio (%s - %d) ocupa %s (saida do alivio)", ((Trem) agent).prefixo, agent.getId(), f.recurso.getName()));
}]]></Code>
							</Value>
						</Parameter>
