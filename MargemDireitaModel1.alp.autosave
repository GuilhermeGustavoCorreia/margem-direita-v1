						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// bracell começa a licenciar pela val_via2; os outros pela via3_intermar
boolean bracell = "bracell".equals(((Trem) agent).get_terminal_name());
((Trem) agent).faixa_atual   = bracell ? faixa_val_via2      : faixa_via3_intermar;
((Trem) agent).proxima_faixa = bracell ? faixa_via3_intermar : faixa_via3_a;

if (trace_circulacao) Log.info("GesCirculacao", "exit_para_via3_ate_santa", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));
tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
