							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("para_esperar_resto_3000", agent, "saiu");
// MRS - o que sobrou da 1a manobra (locos FIPS na cauda) volta para a 3000 e espera o 2o encoste.
// Mantem as locos FIPS e a 3000 (linha3000_lote_em_descarga); libera a manobra das linhas 04/05.
trem_em_encoste = null;
lote_linha3000_emDescarga = (Trem) agent;
Log.info("TES", "resto_3000", String.format("lote=%d voltou para a 3000 com %d vagoes", agent.getId(), ((Trem) agent).getNumeroDeVagoes()));
iniciar_descarga_moegas();
esperar_resto_3000.take(agent);]]></Code>
