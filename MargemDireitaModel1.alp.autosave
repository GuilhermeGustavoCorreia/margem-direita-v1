					<Body><![CDATA[int vagoes_linha_2000_emDescarga = main().getNumeroDeVagoes(lote_linha2000_emDescarga);
int vagoes_linha_2000_proximo 	 = main().getNumeroDeVagoes(lote_linha2000_proximo);
