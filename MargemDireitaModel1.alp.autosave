						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[traceln("==========TIRAR===========");

traceln(
    "Vagões posicionados? " +
    (main().getTrensEmListaDeTracks(linhas_vazios) == 1 ? "OK" : "NÃO OK")
);

traceln(
    "Vagões Vazios + Vagões Descarregando: " +
    main().getVagoesEntrePontos_variasTracks(
        main().posFim_CLTerra,
        main().posInicio_CLTerra,
        linhas_vazios
    ) +
    " + " +
    _loteNaMoega.size() + " = " +
    (main().getVagoesEntrePontos_variasTracks(
        main().posFim_CLTerra,
        main().posInicio_CLTerra,
        linhas_vazios
    ) + _loteNaMoega.size())
);

traceln(
    "Não esta ocorrendo alívio? " +
    (_ocorrendoAlivio ? "SIM" : "NÃO")
