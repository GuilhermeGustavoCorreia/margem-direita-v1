						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-080: chegada no MoegaoTerra (vem do GestorDeCirculacao.para_coperXXI, que decide pelo terminal)
if (agent instanceof Trem) {
	Vagao v = ((Trem) agent).getPrimeiroVagao();
	if (v != null) {
		ferrovia_em_atendimento = v.ferrovia;
		produto_em_atendimento  = v.segmento;
	}
}
traceln(String.format("[%.1f][MoegaoTerra][chegada] trem=%d carros=%d", time(), agent.getId(), ((Trem) agent).size()));
// terminal não recebe outro trem até este entrar no ciclo da moega
_trem_chegando = (Trem) agent;]]></Code>
							</Value>
