				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[float]]></ReturnType>
					<Id>1790950228294</Id>
					<Name><![CDATA[getOverloadVazios]]></Name>
					<X>-810</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean moega_esta_desocupada     = moega_ocupada.idle() > 0;
boolean ultimos_vazios_no_terminal = (_getVagoesCarregados() == 0 && _getVagoesVazios() > 0);

//ultimos vagoes
if (moega_esta_desocupada && ultimos_vazios_no_terminal) {
    return (float) 2.0;
}

if (QUANTIDADE_PARA_ALIVIAR <= 0) return 0;
return (float) _getVagoesVazios() / QUANTIDADE_PARA_ALIVIAR;]]></Body>
