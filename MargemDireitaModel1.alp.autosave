				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1790858621323</Id>
					<Name><![CDATA[descarregarVagoes_LoteParcial]]></Name>
					<X>80</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[qtd]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[doInicio]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int descarregados = 0;
int n = this.size();

for (int k = 0; k < n && descarregados < qtd; k++) {
    int i = doInicio ? k : n - 1 - k;
    Agent carro = getCar(i);

    if (carro instanceof Vagao && ((Vagao) carro).carregado) {
        ((Vagao) carro).descarregarGrao();
        descarregados++;
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790858980986</Id>
					<Name><![CDATA[esta_totalmente_descarregado]]></Name>
					<X>80</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (int i = 0; i < this.size(); i++) {
    Agent carro = getCar(i);
    if (carro instanceof Vagao && ((Vagao) carro).carregado)
        return false;
}
return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1790865877787</Id>
					<Name><![CDATA[fracionar]]></Name>
					<X>100</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[qtd]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ateFimOuLoco]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[locoNaCabeca]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[doInicio]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int n = this.size();
int inicio = 0;

// Locos na cabeça (início ou fim, conforme a direção)
if (locoNaCabeca) {
    while (inicio < n && getCar(doInicio ? inicio : n - 1 - inicio) instanceof Locomotiva)
        inicio++;

}

// Limite: fim do trem ou próxima locomotiva
int limite = n;
if (ateFimOuLoco) {
    for (int k = inicio; k < n; k++) {
        if (getCar(doInicio ? k : n - 1 - k) instanceof Locomotiva) {
            limite = k;

            break;
        }
    }

}

int resultado = Math.min(inicio + qtd, limite);

// TrainDecouple conta sempre a partir do início do trem
if (!doInicio)
    resultado = n - resultado;

return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790870054848</Id>
					<Name><![CDATA[temLocomotiva]]></Name>
					<X>100</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[naCabeca]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (this.size() == 0) return false;
return (naCabeca ? getFirst() : getLast()) instanceof Locomotiva;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791640000232</Id>
					<Name><![CDATA[getCarrosAtrasDoHelper]]></Name>
					<X>100</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-005: quantos carros existem atrás da locomotiva helper
// (1ª locomotiva depois do bloco de locos da cabeça). Retorna -1 se não houver helper.
int n = this.size();
int i = 0;
while (i < n && getCar(i) instanceof Locomotiva) i++;   // pula as locos da cabeça
for (; i < n; i++) {
    if (getCar(i) instanceof Locomotiva) return n - 1 - i;
}
return -1;]]></Body>
				</Function>
			</Functions>


