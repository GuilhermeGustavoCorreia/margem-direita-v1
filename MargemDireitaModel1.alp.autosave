								<Code><![CDATA[// licencia a val_via2 e a isn_linha02_e antes de sair das DVs (o ir_saida passa pelo AMV da saída do ISN)
// o liberar_faixas_circulacao (depois do trainExit) solta junto com as outras faixas do trem
main().gestorDeCirculacao.faixa_val_via2.ocupar((Trem) agent);
// a saída passa pela isn_linha02_e (travessão do ISN)
main().gestorDeISN.faixa_isn_linha02_e.ocupar((Trem) agent);
Log.info("GesDVs", "ocupar_val_via2_saida", String.format("trem=%d pegou", agent.getId()));]]></Code>
