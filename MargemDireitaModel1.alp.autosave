				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791296866655</Id>
					<Name><![CDATA[alvoAcumulado4000]]></Name>
					<X>4525</X><Y>1480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[RailwayTrack[] linhas = { main().pmc_linha4000_a, main().pmc_linha4000_b, main().pmc_linha4000_c };

double total = 0;
for (RailwayTrack l : linhas) total += l.length(METER);

double compTrem = trem.getLength(METER);
double alvo = Math.max(0, total - compTrem);


// posição atual da cauda (último carro, lidera no recuo)
Agent cauda = trem.getLast();
try {
    
    RailwayTrack tr = (RailwayTrack) cauda.getClass().getMethod("getTrack", boolean.class).invoke(cauda, false);
    
    double off = (double) cauda.getClass().getMethod("getOffset", boolean.class).invoke(cauda, false);
    double acum = 0;
    
    for (RailwayTrack l : linhas) {
        if (tr == l) {
            double atual = acum + off;

            if (atual <= alvo + 0.5) {
                
                double novo = Math.max(0, atual - 10);
                return novo;
                
            }
            
            break;
            
        }
        
        acum += l.length(METER);
        
    }
} catch (Exception e) {
    error("alvoAcumulado4000: " + e.getMessage());
}

return alvo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RailwayTrack]]></ReturnType>
					<Id>1791296902104</Id>
					<Name><![CDATA[getTrack4000]]></Name>
					<X>4525</X><Y>1500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[RailwayTrack[] linhas = { main().pmc_linha4000_a, main().pmc_linha4000_b, main().pmc_linha4000_c };
double alvo = alvoAcumulado4000(trem);

double acum = 0;
for (RailwayTrack l : linhas) {
    double comp = l.length(METER);
    if (alvo < acum + comp) return l;
    acum += comp;
}
return linhas[linhas.length - 1];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791296932666</Id>
					<Name><![CDATA[getOffset4000]]></Name>
					<X>4525</X><Y>1520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[RailwayTrack[] linhas = { main().pmc_linha4000_a, main().pmc_linha4000_b, main().pmc_linha4000_c };
double alvo = alvoAcumulado4000(trem);

double acum = 0;
for (RailwayTrack l : linhas) {
    double comp = l.length(METER);
    if (alvo < acum + comp) return alvo - acum;
    acum += comp;
}
return linhas[linhas.length - 1].length(METER);]]></Body>
				</Function>
