				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<Faixa>]]></ReturnType>
					<Id>1793298470508</Id>
					<Name><![CDATA[get_faixas_primeiro_alivio]]></Name>
					<X>-630</X><Y>330</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-079: linhas físicas entre a faixa de criação (via1_intermar_d) e a pstLinha04 (lote_b do MoegaoMar).
// Não são faixas da circulação: só entram na rota da loco (TrainMoveTo por lista de linhas).
// Sem recurso (não licencia nada) e com desenho invisível (o gestor pinta a faixa ao ocupar).
ArrayList<Faixa> faixas = new ArrayList<Faixa>();
for (RailwayTrack t : new RailwayTrack[] { main().linhaPaqueta_a, main().psnSaidaCopexXXI_a, main().pstSaidaMoegao }) { // ALT-079
	Faixa f     = new Faixa();
	f.track     = t;
	f.recurso   = null;
	f.estado    = Faixa.EstadoFaixa.LIVRE;
	f.linhaTMDS = new ShapePolyLine();
	faixas.add(f);
}
return faixas;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<Faixa>]]></ReturnType>
					<Id>1793298470510</Id>
					<Name><![CDATA[get_primeiras_linhas_de_circulacao_vazios]]></Name>
					<X>-630</X><Y>360</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-003: provisório — sem faixas até integrar com o GestorDeAlivios
return new ArrayList<Faixa>();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
