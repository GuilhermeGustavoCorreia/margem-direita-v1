				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787603378110</Id>
					<Name><![CDATA[inicializar]]></Name>
					<X>60</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Log.iniciar(this);

//coordenadas_ferroviarias.put(main().pos_locoAlivio_PMC,    9);
//coordenadas_ferroviarias.put(main().pos_circ_alivio_tgrao, 10); 

linhas_e_recursos.put(rp_linha5000, coll_trecho5000);

linhas_e_recursos.put(rp_linha_intervalo4000, 		coll_intervalo4k		);
linhas_e_recursos.put(rp_linha_marginalRetaVelha, 	coll_marginalRetaVelha	);
linhas_e_recursos.put(rp_linha_via2, 				coll_via2				);
linhas_e_recursos.put(rp_linha_via2_intermar, 		coll_via2_intermar		); 

Log.info("GesCirculacao", "startup", "linhas_e_recursos");]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787667154475</Id>
					<Name><![CDATA[configurar_rota]]></Name>
					<X>50</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[destino = trem.posicao_destino;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1789317324799</Id>
					<Name><![CDATA[liberar_faixas_ocupadas]]></Name>
					<Description><![CDATA[Libera todas as faixas ocupadas pelo trem informado que já estão fisicamente vazias (sem trens sobre a track). Para cada faixa liberada, reseta idTremLicenciado e muda o estado para LIVRE, retornando os ResourcePool correspondentes para uso no bloco Release.]]></Description>
					<X>920</X><Y>1010</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[List<ResourcePool> recursosLiberados = new ArrayList<>();

// [diag_liberar]: o que o trem realmente possui entre os pools das faixas
StringBuilder possui = new StringBuilder();

for (Faixa f : faixas) {
    
    if (!trem.resourceUnitsOfPool(f.recurso).isEmpty())
       
        possui.append(f.recurso.getName()).append(" ");
}

for (Faixa faixa : faixas) {

    boolean faixaDoTrem = (faixa.idTremLicenciado == trem.getId());
    boolean faixaOcupada = (faixa.estado == Faixa.EstadoFaixa.OCUPADA);

    if (faixaDoTrem && faixaOcupada) {

        boolean faixaEstaVazia = faixa.faixaEstaVazia();
        boolean temUnidade     = !trem.resourceUnitsOfPool(faixa.recurso).isEmpty();

        // [diag_liberar]: cada faixa candidata a liberacao
        // a faixa sempre sai de OCUPADA quando o trem já saiu dela.
        // Só entra na lista de Release o recurso que o trem realmente possui
        // (Release em SPECIFIED_RESOURCES dá erro se o agente não tiver a unidade).
   
        if (faixaEstaVazia) {
            
            faixa.liberar();
            if (temUnidade) {
                recursosLiberados.add(faixa.recurso);
            }
        }
    }
}

// trem de alívio da área comum (Tgrao, Bracell, Eldorado, Suzano): solta o mnb_pcx
// só quando a cauda já passou da marginal_c (último trecho da área comum na saída)
if (trem.eh_alivio && faixa_marginal_c.idTremLicenciado != trem.getId()) {
    for (ResourcePool rp : get_recursos_mnb_pcx(trem)) {
        if (!recursosLiberados.contains(rp)) {
            recursosLiberados.add(rp);
            log_circulacao(trem, "soltou mnb_pcx (saiu da marginal_c)");
        }
    }
}

return recursosLiberados.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790699074295</Id>
					<Name><![CDATA[bloquear_faixas]]></Name>
					<X>50</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[faixas]]></Name>
						<Type><![CDATA[List<Faixa>]]></Type>
					</Parameter>
					<Body><![CDATA[for (Faixa f : faixas) {
    f.bloquear(trem);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1792014000500</Id>
					<Name><![CDATA[get_recursos_linha_5000_6000]]></Name>
					<X>920</X><Y>1080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// pools da linha 5000/6000 que o trem realmente possui
// (Release em SPECIFIED_RESOURCES dá erro se o agente não tiver a unidade)
List<ResourcePool> pools = new ArrayList<>();
for (ResourcePool rp : java.util.List.of(rp_linha5000, rp_linha6000)) {
    if (!trem.resourceUnitsOfPool(rp).isEmpty()) pools.add(rp);
}
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793910000002</Id>
					<Name><![CDATA[log_circulacao]]></Name>
					<X>330</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[status]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Log padrao: origem GesCirculacao, texto [(prefixo - id): segmento destino] [status]
Trem t = (Trem) trem;
String destino = t.ITerminalMoega_destino == null ? "sem destino" : t.ITerminalMoega_destino.getName();
Log.info("GesCirculacao", "circulacao", String.format("[(%s - %d): %s %s] [%s]", t.prefixo, t.getId(), t.getSegmento(), destino, status));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793910000003</Id>
					<Name><![CDATA[log_entrada]]></Name>
					<X>160</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[// loga só a primeira entrada do trem no gestor (tentar_usar_faixa recebe o trem a cada faixa)
if (trens_no_gestor.add(trem.getId())) log_circulacao(trem, "comecou circulacao");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793910000004</Id>
					<Name><![CDATA[log_saida]]></Name>
					<X>160</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[status]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// trem deixa o gestor (terminal ou DV)
trens_no_gestor.remove(trem.getId());
// chegou ao terminal: deixa de ser trem a caminho dele (Chegadas e ISN consultam esta lista)
trens_em_circulacao.remove((Trem) trem);
log_circulacao(trem, status);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798140000901</Id>
					<Name><![CDATA[eh_terminal_mnb_pcx]]></Name>
					<X>-2400</X><Y>3900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// terminais que usam o recurso mnb_pcx (encoste, alívio e triangulação na área comum)
String t = trem.get_terminal_name();
return "tgrao".equals(t) || "bracell".equals(t) || "eldorado".equals(t) || "suzano".equals(t);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1798140000902</Id>
					<Name><![CDATA[get_recursos_mnb_pcx]]></Name>
					<X>-2400</X><Y>3880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// rp_mnb_pcx, se o trem tiver a unidade (Release em SPECIFIED_RESOURCES dá erro se não tiver)
if (trem != null && !trem.resourceUnitsOfPool(rp_mnb_pcx).isEmpty()) return new ResourcePool[] { rp_mnb_pcx };
return new ResourcePool[0];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1798140000903</Id>
					<Name><![CDATA[incluir_mnb_pcx]]></Name>
					<X>-2400</X><Y>3920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[recursos]]></Name>
						<Type><![CDATA[ResourcePool[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// junta o rp_mnb_pcx (se o trem tiver a unidade) aos recursos de um Release
List<ResourcePool> pools = new ArrayList<ResourcePool>();
if (recursos != null) for (ResourcePool rp : recursos) if (!pools.contains(rp)) pools.add(rp);
for (ResourcePool rp : get_recursos_mnb_pcx(trem)) if (!pools.contains(rp)) pools.add(rp);
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798300000035</Id>
					<Name><![CDATA[eh_terminal_tec]]></Name>
					<X>-2400</X><Y>3940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// trens do TEC: ISN -> val_via2_a -> dv_entrada_c -> via1_intermar_a (de frente) -> tec.comecar_encoste
return trem != null && "tec".equals(trem.get_terminal_name());]]></Body>
				</Function>
			</Functions>

