				<EmbeddedObject>
					<Id>1791950000005</Id>
					<Name><![CDATA[para_alivio_na_linha_4000]]></Name>
					<X>2560</X><Y>990</Y>
					<Label><X>-10</X><Y>-15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Exit]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Exit]]></ClassName>
							<ItemName><![CDATA[1412336242934]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// alívio na linha 4000: trem com 82 vagões segue para as DVs pelo circuito do GestorDeCirculacao
// intervalo4000_a -> marginal_c -> marginal_b -> marginal_a -> via2_f ... via2_a -> via2_intermar_c..a -> railwayTrack199 -> val_via2
Trem trem = (Trem) agent;
Log.info("GesAlivios", "para_alivio_na_linha_4000", String.format("trem=%d vagoes=%d -> DVs", trem.getId(), main().getNumeroDeVagoes(trem)));

trem.eh_alivio     = true;
trem.faixa_atual   = main().gestorDeCirculacao.faixa_intervalo4000_a;
trem.proxima_faixa = main().gestorDeCirculacao.faixa_marginal_c;

// linha 4000 livre: o próximo ciclo cria uma loco nova
lote_linha_4000        = null;
ferrovia_na_linha_4000 = null;
segmento_na_linha_4000 = null;

// o trem cheio saiu; sem isso aux ficava true e analisar_pcx não aliviava mais nenhum terminal da 4000
aux_esta_ocorrendo_alivio_pcx = false;

// faixas da 4000 onde o trem ainda está ficam OCUPADA até a cauda sair (evita criar loco em cima dele)
ocupar_faixas_saida_4000(trem);

main().gestorDeCirculacao.tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
					<ReplicationFlag>false</ReplicationFlag>
