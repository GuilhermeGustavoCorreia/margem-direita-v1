				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792083865464</Id>
					<Name><![CDATA[atualizarFerroviaEProdutoEmAtendimento]]></Name>
					<X>60</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i); // confere o nome exato do método com Ctrl+Espaço

        if (carro instanceof Vagao) {
            Vagao vagao = (Vagao) carro;
            ferrovia_em_atendimento = vagao.ferrovia;
            segmento_em_atendimento = vagao.segmento;
            return; // achou o primeiro vagão, encerra
        }
    }

    traceln("erro: trem não tem nenhum vagão");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792083865466</Id>
					<Name><![CDATA[_getVagoesVazios]]></Name>
					<X>60</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-022: vazios das linhas mar, meio e terra
return (
	main().getTamanhoDoTrem(_loteDeVazios_LinhaMar) +
	main().getTamanhoDoTrem(_loteDeVazios_LinhaMeio) +
	main().getTamanhoDoTrem(_loteDeVazios_LinhaTerra)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792083865468</Id>
					<Name><![CDATA[_getVagoesCarregados]]></Name>
					<X>60</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-022: carregados que ainda estão nos lotes deixados nos encostes
return (
	main().getTamanhoDoTrem(lote_costaLeite_moegaMeio) +
	main().getTamanhoDoTrem(lote_costaLeite_linhaTerra) +
	main().getTamanhoDoTrem(lote_costaLeite_lateralMoega) +
	main().getTamanhoDoTrem(lote_costaLeite_linhaMar_a) +
	main().getTamanhoDoTrem(lote_costaLeite_linhaMar_b)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792088756450</Id>
					<Name><![CDATA[atualiza_vaiDescarga]]></Name>
					<X>1450</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean aguardandoRechego = false; // ALT-019: CostaLeite ainda não tem rechego (era mnbCarregados_ocupar3.size() > 0)
boolean podeDescarregar   = (waitLotesParaDescarga.size() > 0 && _loteEmDescarga == null);

if (!aguardandoRechego && podeDescarregar) {

	condicao_vaiDescarga = true;
	pegar_um_lote_para_descarga();
	
}

Log.info("CostaLeite", (!aguardandoRechego && podeDescarregar) ? "vai_descarga" : "nao_descarrega", texto_estado());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792088756452</Id>
					<Name><![CDATA[pegar_um_lote_para_descarga]]></Name>
					<X>1450</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (String tipo : _prioridadeDeLotesDescarga) {

    for (int i = 0; i < waitLotesParaDescarga.size(); i++) {

		Agent ag  = waitLotesParaDescarga.get(i);
		Trem trem = (Trem) ag;

        if (tipo.equals(trem.tipoDeLote)) {

            waitLotesParaDescarga.free(ag); 
            return; 
        }
    }
}
]]></Body>
				</Function>
