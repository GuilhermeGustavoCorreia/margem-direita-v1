				<EmbeddedObject>
					<Id>1788185331273</Id>
					<Name><![CDATA[para_circVzs]]></Name>
					<X>2280</X><Y>1110</Y>
					<Label><X>-10</X><Y>-15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Exit]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Exit]]></ClassName>
							<ItemName><![CDATA[1412336242934]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("para_circVzs", agent, "saiu");
// ALT-014: fim do alívio da Bracell. O trem sai com os vazios pelo circuito do GestorDeCirculacao, de ré:
// intervalo4000_c -> b -> a -> marginal_c -> marginal_b -> marginal_a -> via2_f ... via2_a -> via2_intermar_c..a -> railwayTrack199 -> val_via2 -> DVs
Trem trem = (Trem) agent;
traceln(String.format("[%.1f][Bracell][para_circVzs] trem=%d vagoes=%d -> circulacao", time(), trem.getId(), main().getNumeroDeVagoes(trem)));

// ALT-061: a Bracell só informa a saída; o GestorDeAlivios solta a trava,
// devolve a Bracell para terminais_pmc e entrega o trem ao GestorDeCirculacao
trem.faixa_atual   = main().gestorDeCirculacao.faixa_intervalo4000_c;
trem.proxima_faixa = main().gestorDeCirculacao.faixa_intervalo4000_b;

main().gestorDeAlivios.retornar_alivio_pmc(trem);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
					<ReplicationFlag>false</ReplicationFlag>
					<Replication Class="CodeValue">
						<Code><![CDATA[100]]></Code>
					</Replication>
