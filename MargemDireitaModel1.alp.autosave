							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-003.3: fim da via3_intermar -> via3_a; reserva a seguinte conforme o destino
boolean coperXI_ou_pera = ("coperXI".equals(((Trem) agent).ITerminalMoega_destino.getName()) || "coperXXI".equals(((Trem) agent).ITerminalMoega_destino.getName()) || "moegaoMar".equals(((Trem) agent).ITerminalMoega_destino.getName()) || "moegaoTerra".equals(((Trem) agent).ITerminalMoega_destino.getName()));
((Trem) agent).faixa_atual   = faixa_via3_a;
((Trem) agent).proxima_faixa = coperXI_ou_pera ? faixa_via2_c : faixa_via3_b;

tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
