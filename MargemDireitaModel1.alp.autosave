				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1785972407335</Id>
					<Name><![CDATA[_éUltimoLote]]></Name>
					<X>1490</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[Boolean temVagoesNaMoega 		=  main().getTamanhoDoTrem(lote_descarga) > 0 ? true : false;
Boolean temCarregadosNaPera		= main().getTamanhoDoTrem(lote_pera) > 0 ? true : false;

if (temVagoesNaMoega || temCarregadosNaPera){

 	return false;
 	
}else{

	return true;
	
}]]></Body>
