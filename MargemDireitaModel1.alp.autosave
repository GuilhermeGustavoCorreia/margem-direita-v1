		<JavaClass>
			<Id>1795840000002</Id>
			<Name><![CDATA[FluxoChegada]]></Name>
			<Folder>1789278685762</Folder>
			<Text><![CDATA[public class FluxoChegada implements Serializable {

    public FluxoChegada() {
    }

    public ITerminalMoega   terminal;
    public String           instancia;
    public String           ferrovia;          // "rumo" | "mrs" | "vli"
    public com.anylogic.libraries.rail.TrainSource fonte;
    public double           intervalo_h;
    public double           proxima_h;
    public int              gerados;

    private static final long serialVersionUID = 1L;
}
]]></Text>
