				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786368889158</Id>
					<Name><![CDATA[atualiza_terminaisEmOverload]]></Name>
					<Description><![CDATA[Ela monta uma lista com os terminais em sobrecarga de vazios, do mais sobrecarregado para o menos:

    Limpa a lista terminais_emOverload.
    Percorre todas as moegas de colecaoMoegas e pega o getOverloadVazios() de cada uma.
    Adiciona na lista só as que têm overload maior que 1, guardando o terminal junto com o valor.
    Ordena a lista em ordem decrescente de overload, então o primeiro elemento é o terminal mais crítico.

]]></Description>
					<X>990</X><Y>-515</Y>
					<Label><X>12</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[terminais_emOverload.clear();

for (ITerminalMoega terminal : colecaoMoegas) {
    
    float overload = terminal.getOverloadVazios();
    
    if (overload > 1) {
        terminais_emOverload.add(new TerminalOverload(terminal, overload));
    }
}

Collections.sort(terminais_emOverload, (a, b) ->
    Float.compare(b.overload, a.overload)
);
]]></Body>
				</Function>
