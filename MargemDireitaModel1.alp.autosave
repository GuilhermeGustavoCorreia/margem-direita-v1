							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// lote de vazios sai com o alívio
lote_linha_7 = null;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExitTrue]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("tem_excesso_l7", agent, "true");
// excesso = vagões que vieram da linha 7 além da quantidade_alivio
int excesso = ((Trem) agent).getNumeroDeVagoes() - qt_vgs_inicio_alivio - quantidade_alivio;
Log.info("ADM", "alivio", String.format("trem=%d vagoes=%d (trazia %d) -> excesso=%d volta para a linha 7", agent.getId(), ((Trem) agent).getNumeroDeVagoes(), qt_vgs_inicio_alivio, excesso));
if (excesso > CAPACIDADE_LINHA_7) {
    Log.erro("ADM", "alivio", String.format("excesso=%d maior que CAPACIDADE_LINHA_7=%d", excesso, CAPACIDADE_LINHA_7));
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExitFalse]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("tem_excesso_l7", agent, "false");]]></Code>
							</Value>
						</Parameter>
