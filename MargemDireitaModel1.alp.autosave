				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792408584803</Id>
					<Name><![CDATA[atualizarFerroviaEProdutoEmAtendimento]]></Name>
					<X>70</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i); // confere o nome exato do método com Ctrl+Espaço

        if (carro instanceof Vagao) {
            Vagao vagao = (Vagao) carro;
            ferrovia_em_atendimento = vagao.ferrovia;
            segmento_em_atendimento = vagao.segmento;
            return; // achou o primeiro vagão, encerra
        }
    }

    traceln("erro: trem não tem nenhum vagão");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792408584805</Id>
					<Name><![CDATA[_getVagoesVazios]]></Name>
					<X>70</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-057: vazios das linhas L1..L4
// ALT-059: e os 30 vazios deixados na L7000 na troca
int vazios_linha_L1 = main().getTamanhoDoTrem(loteVazios_L1);
int vazios_linha_L2 = main().getTamanhoDoTrem(loteVazios_L2);
int vazios_linha_L3 = main().getTamanhoDoTrem(loteVazios_L3);
int vazios_linha_L4 = main().getTamanhoDoTrem(loteVazios_L4);
int vazios_L7000    = main().getTamanhoDoTrem(loteVazios_L7000);
return (
	vazios_linha_L1 +
	vazios_linha_L2 +
	vazios_linha_L3 +
	vazios_linha_L4 +
	vazios_L7000
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792408584807</Id>
					<Name><![CDATA[_getVagoesCarregados]]></Name>
					<X>70</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-057: carregados nas linhas L1..L4 e no lote que ficou na L7000
int carregados_linha_L1 = main().getTamanhoDoTrem(lote_carregados_L1);
int carregados_linha_L2 = main().getTamanhoDoTrem(lote_carregados_L2);
int carregados_linha_L3 = main().getTamanhoDoTrem(lote_carregados_L3);
int carregados_linha_L4 = main().getTamanhoDoTrem(lote_carregados_L4);
int carregados_L7000    = main().getTamanhoDoTrem(lote_L7000);
return (
	carregados_linha_L1 +
	carregados_linha_L2 +
	carregados_linha_L3 +
	carregados_linha_L4 +
	carregados_L7000
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792770000043</Id>
					<Name><![CDATA[registrar_linha_descarregada]]></Name>
					<X>70</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-059: conta as linhas da 1a rodada (40 vagões) que terminaram a descarga.
// Com as 4 descarregadas, bloqueia os holds para a 2a rodada e chama a loco FIPS da troca.
linhas_descarregadas++;
traceln(String.format("[%.1f][Suzano][registrar_linha_descarregada] %d de 4 linhas descarregadas", time(), linhas_descarregadas));
if (linhas_descarregadas >= 4) {
	linhas_descarregadas = 0;
	em_troca = true;
	aguarda_L4a.block();
	aguarda_L4b.block();
	aguarda_L4c.block();
	traceln(String.format("[%.1f][Suzano][registrar_linha_descarregada] chama loco FIPS para a troca dos 24", time()));
	loco_pcx_starts.inject();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792770000044</Id>
					<Name><![CDATA[verificar_descarregou_tudo]]></Name>
					<X>70</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-059: fim da troca quando L1..L3 descarregaram e os vazios estão na L7000 (ALT-060: 24 vazios).
// Liga o overload (2,0) e deixa os holds bloqueados para o próximo trem.
if (loteVazios_L1 != null && loteVazios_L2 != null && loteVazios_L3 != null && loteVazios_L7000 != null) {
	descarregou_tudo = true;
	em_troca = false;
	aguarda_L4a.block();
	aguarda_L4b.block();
	aguarda_L4c.block();
	traceln(String.format("[%.1f][Suzano][verificar_descarregou_tudo] %d vazios, overload = 2,0", time(), _getVagoesVazios()));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1792795000007</Id>
					<Name><![CDATA[get_recursos_loco_alivio]]></Name>
					<X>70</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// ALT-063: pools que a loco do alívio trouxe e ainda segura:
// linha 5000/6000 (ocupar_linha5000_6000) e as faixas do caminho (bloquear_faixas_pmc).
List<ResourcePool> pools = new ArrayList<ResourcePool>();
for (ResourcePool rp : main().gestorDeCirculacao.get_recursos_linha_5000_6000(trem)) pools.add(rp);
for (Faixa f : primeiro_alivio_faixas) {
	if (f != null && f.recurso != null && !pools.contains(f.recurso) && !trem.resourceUnitsOfPool(f.recurso).isEmpty()) pools.add(f.recurso);
}
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1796400000031</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>550</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("Suzano", evento, t + " | " + msg);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798160000001</Id>
					<Name><![CDATA[terminal_ocupado]]></Name>
					<X>550</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// trem a caminho deste terminal (já mandado para a circulação, ainda não chegou ao comecar_encoste)
for (Trem t : main().gestorDeCirculacao.trens_em_circulacao) {
	if (t.ITerminalMoega_destino == this) return true;
}
// trem entrando: do comecar_encoste até o 1º lote ficar no terminal
if (_trem_chegando != null) return true;
// troca dos 24 em andamento (os lotes mudam de variável)
if (em_troca) return true;
if (_getVagoesCarregados() > 0) return true;
// vazios no terminal (esperando ou em alívio)
return _getVagoesVazios() > 0;]]></Body>
				</Function>
			</Functions>

