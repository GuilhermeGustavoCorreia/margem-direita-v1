					<Id>1791670000001</Id>
					<Name><![CDATA[para_via3_b]]></Name>
					<X>-2800</X><Y>4040</Y>
					<Label><X>-10</X><Y>-15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Exit]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Exit]]></ClassName>
							<ItemName><![CDATA[1412336242934]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// -> via3_b; a seguinte e a via2_e se coperXI ou costaLeite, senao a via3_c
boolean coperXI = "coperXI".equals(((Trem) agent).get_terminal_name()) || "costaLeite".equals(((Trem) agent).get_terminal_name());
((Trem) agent).faixa_atual   = faixa_via3_b;
((Trem) agent).proxima_faixa = coperXI ? null : faixa_via3_c; // ALT-103: coperXI/costaLeite pegam a via2_e junto com as marginais no bloquear_encoste_marginal
if (trace_circulacao) Log.info("GesCirculacao", "exit_para_via3_b", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));

// tgrao, bracell, eldorado e suzano: pega o mnb_pcx antes de licenciar a via3_c
// (a saída do alívio do Tgrao usa a via3_c; ALT-147)
if (eh_terminal_mnb_pcx((Trem) agent)) entrar_mnb_pcx.take(agent);
else tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
