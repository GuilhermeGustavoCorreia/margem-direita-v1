			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781892511343</Id>
					<Name><![CDATA[descarregar]]></Name>
					<X>-75</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[switch (ferrovia) {
    
    case "rumo": 
	    
	    vagao_carregado_rumo.setVisible(false); 
	    vagao_vazio_rumo.setVisible(true);
	    break;
	    
    case "mrs":  
	    
	    vagao_carregado_mrs.setVisible(false);
	    vagao_vazio_mrs.setVisible(true);  
	    break;
	    
    case "vli":  
	    
	    vagao_carregado_vli.setVisible(false);  
	    vagao_vazio_mrs.setVisible(true);
	    break;
    
    default:
    
        error("Ferrovia desconhecida: '" + ferrovia + "'");
        return;
}

carregado = false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791556207683</Id>
					<Name><![CDATA[setSegmento]]></Name>
					<X>-75</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[seg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[segmento = seg;

switch (segmento) {
    
    case "acucar": 	
    
    	retangulo_acucar.setVisible(true); 
    	break;
    
    case "grao":  	
    	
    	retangulo_grao.setVisible(true);  
    	break;
  
	case "celulose":  	
    	
    	retangulo_grao.setVisible(true);  
    	break;
    
    default:
        error("Segmento desconhecido: '" + segmento + "'");
        return;
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791556216106</Id>
					<Name><![CDATA[setFerrovia]]></Name>
					<X>-75</X><Y>-80</Y>
					<Label><X>11</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferr]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[ferrovia = ferr;

switch (ferrovia) {
    
    case "rumo": vagao_carregado_rumo.setVisible(true); break;
    case "mrs":  vagao_carregado_mrs.setVisible(true);  break;
    case "vli":  vagao_carregado_vli.setVisible(true);  break;
    
    default:
        error("Ferrovia desconhecida: '" + ferrovia + "'");
        return;
}
]]></Body>
				</Function>
