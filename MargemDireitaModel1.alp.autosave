					<Id>1783520667992</Id>
					<Name><![CDATA[getLinhaCirculacao_v2]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1520</X><Y>-7480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[Vagao primeiroVagao = trem.getPrimeiroVagao();
String moegaDestino = primeiroVagao.moegaDestino;

switch (moegaDestino) {
			
	case "coper-XXI":
	
		return posAtend_coperXXI;
		
	case "moegao-mar":
	
		return posAtend_moegaoMar;
	
			
	case "moegao-terra":
	
		return posAtend_moegaoTerra;
	
	
    default:
    
        return posAtend_Santa;
}]]></Body>
				</Function>
