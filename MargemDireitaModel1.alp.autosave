				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790946504960</Id>
					<Name><![CDATA[sobraram_somente_locomotivas]]></Name>
					<X>220</X><Y>1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[train]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[//traceln("[soLocos] trem " + train + " | n=" + train.size());

if (train.size() == 0) {
    //traceln("[soLocos]   trem vazio -> false");
    return false;
}

for (int i = 0; i < train.size(); i++) {
    Agent car = train.getCar(i);
    if (!(car instanceof Locomotiva)) {
        //traceln("[soLocos]   carro " + i + " não é loco (" + car.getClass().getSimpleName() + ") -> false");
        return false;
    }
}

//traceln("[soLocos]   todos os " + train.size() + " carros são locos -> true");
return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790949291562</Id>
					<Name><![CDATA[atualizarFerroviaEProdutoEmAtendimento]]></Name>
					<X>-400</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i); // confere o nome exato do método com Ctrl+Espaço

        if (carro instanceof Vagao) {
            Vagao vagao = (Vagao) carro;
            ferrovia_em_atendimento = vagao.ferrovia;
            produto_em_atendimento = vagao.segmento;
            return; // achou o primeiro vagão, encerra
        }
    }

    traceln("erro: trem não tem nenhum vagão");]]></Body>
				</Function>
