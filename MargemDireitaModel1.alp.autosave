				<EmbeddedObject>
					<Id>1791545210163</Id>
					<Name><![CDATA[configurar_para_circulacao]]></Name>
					<X>520</X><Y>1030</Y>
					<Label><X>-40</X><Y>60</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Delay]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Delay]]></ClassName>
							<ItemName><![CDATA[1412336242930]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[1]]></Code>
								<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Trem t = (Trem) agent;
GestorDeCirculacao gc = main().gestorDeCirculacao;

// tgrao sai em pst_silosMuro_a (pos_saida_tgrao) e segue silosMuro_a > via3_c > via3_b > via3_a > via3_intermar
if ("tgrao".equals(t.referencia_alivio)) {

    t.faixa_atual   = gc.faixa_marginal_c;
    t.proxima_faixa = gc.faixa_marginal_b;
    
} else if (gc.faixa_via1_intermar_c.track.getTrains().contains(t)) {

    // trem longo: no avanço do alívio a ponta passou da via1_intermar_d para a c
    t.faixa_atual   = gc.faixa_via1_intermar_c;
    t.proxima_faixa = gc.faixa_via1_intermar_b;
    
} else {

    t.faixa_atual   = gc.faixa_via1_intermar_d;
    t.proxima_faixa = gc.faixa_via1_intermar_c;
    
}

if (gc.faixa_via1_intermar_b.track.getTrains().contains(t)) {
    Log.warn("GesAlivios", "retorno_alivio", String.format("(%s - %d) chegou na via1_intermar_b sem licenca", t.prefixo, t.getId()));
}

// faixa que o trem já possui desde o alívio: fica LICENCIADA para a circulação não apreender de novo
for (Faixa f : new Faixa[] { t.faixa_atual, t.proxima_faixa }) {
    if (f != null && f.recurso != null && !t.resourceUnitsOfPool(f.recurso).isEmpty()) {
        f.licenciar(t);
    }
}

Log.info("GesAlivios", "retorno_alivio", String.format("(%s - %d) entra na circulacao por %s (proxima %s)",
    t.prefixo, t.getId(), t.faixa_atual.recurso.getName(),
    t.proxima_faixa == null ? "-" : t.proxima_faixa.recurso.getName()));

t.eh_alivio = true;]]></Code>
							</Value>
						</Parameter>
