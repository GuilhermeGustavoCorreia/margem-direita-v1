				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792526183276</Id>
					<Name><![CDATA[descarregar_vagoes]]></Name>
					<X>100</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[eh_frente]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qt_vagoes]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int n 			  = size();
int descarregados = 0;

for (int i = 0; i < n && descarregados < qt_vagoes; i++) {

    int idx = eh_frente ? i : (n - 1 - i);
    Agent carro = getCar(idx);

    if (carro instanceof Vagao) {
        
        Vagao vagao = (Vagao) carro;

        if (vagao.carregado) {
            
            vagao.descarregar();
            descarregados++;
            
        }
    }
}

if (descarregados < qt_vagoes) {
    traceln(String.format("[%.1f][Trem][descarregar_vagoes] trem=%d pediu %d, descarregou %d",
        time(), getId(), qt_vagoes, descarregados));
}]]></Body>
				</Function>
			</Functions>


