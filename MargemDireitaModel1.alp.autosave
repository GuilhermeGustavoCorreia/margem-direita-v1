							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-062: linha 5000/6000 (ocupar_linha5000_6000 do GestorDeAlivios)
// ALT-063: e as faixas do caminho da loco (bloquear_faixas_pmc)
get_recursos_loco_alivio((Trem) agent)]]></Code>
							</Value>
						</Parameter>
