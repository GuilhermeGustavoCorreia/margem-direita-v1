					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// fim da intervalo4000_c -> entrega ao terminal (linha 5000)
if (trace_circulacao) Log.info("GesCirculacao", "exit_continuar5", String.format("trem=%d destino=%s", agent.getId(), ((Trem) agent).get_terminal_name()));
log_saida(agent, "saiu para terminal " + ((Trem) agent).get_terminal_name());
if ("bracell".equals(((Trem) agent).get_terminal_name())) {
    main().bracell.encoste.take(agent);
} else {
    error("GestorDeCirculacao: sem rota apos pmc_intervalo4000_c para " + ((Trem) agent).get_terminal_name());
}]]></Code>
							</Value>
						</Parameter>
