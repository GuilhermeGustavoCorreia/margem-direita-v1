					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// fim da via3_intermar -> via3_a; a seguinte e a via2_c se pera, senao a via3_b
boolean pera = ("coperXXI".equals(((Trem) agent).get_terminal_name()) || "moegaoMar".equals(((Trem) agent).get_terminal_name()) || "moegaoTerra".equals(((Trem) agent).get_terminal_name()));
((Trem) agent).faixa_atual   = faixa_via3_a;
((Trem) agent).proxima_faixa = pera ? faixa_via2_c : faixa_via3_b;
if (trace_circulacao) Log.info("GesCirculacao", "exit_para_via3_a", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));

tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
					<ReplicationFlag>false</ReplicationFlag>
					<Replication Class="CodeValue">
						<Code><![CDATA[100]]></Code>
					</Replication>
