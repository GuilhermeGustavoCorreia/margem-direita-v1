					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (trace_circulacao) Log.info("GesCirculacao", "exit_para_coperXXI", String.format("trem=%d", agent.getId()));
// entrega o trem ao CoperXXI
// a pera atende CoperXXI, MoegaoMar e MoegaoTerra; decide pelo terminal do trem
log_saida(agent, "saiu para terminal " + ((Trem) agent).get_terminal_name());
if ("moegaoMar".equals(((Trem) agent).get_terminal_name())) main().moegaoMar.comecar_encoste.take(agent);
else if ("moegaoTerra".equals(((Trem) agent).get_terminal_name())) main().moegaoTerra.comecar_encoste.take(agent);
else main().coperXXI.comecar_encoste.take(agent);]]></Code>
							</Value>
						</Parameter>
					</Parameters>
