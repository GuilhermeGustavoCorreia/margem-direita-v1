				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792519031770</Id>
					<Name><![CDATA[podeReceberNovoLote]]></Name>
					<X>-330</X><Y>460</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// trem entrando: do comecar_encoste até parar na linha 3000
if (_trem_chegando != null) return false;
// a 3000 comporta um trem só: o resto fica nela durante o ciclo
return lote_linha3000_emDescarga == null && lote_linha3000_proximo == null;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[float]]></ReturnType>
					<Id>1792519031772</Id>
					<Name><![CDATA[getOverloadVazios]]></Name>
					<X>-330</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// padrao do T39
boolean moegas_livres  = rp_moega03.idle() > 0 && rp_moega04.idle() > 0;
// segundo lote de outra ferrovia/segmento não conta: ele só entra depois do alívio destes vazios
int carregados = _getVagoesCarregados();
if (lote_linha3000_proximo != null && !eh_mesmo_tipo_em_atendimento(lote_linha3000_proximo))
    carregados -= main().getNumeroDeVagoes(lote_linha3000_proximo);
boolean ultimos_vazios = (carregados <= 0 && _getVagoesVazios() > 0);

// ultimos vazios do terminal: forca o alivio
if (moegas_livres && ultimos_vazios) return (float) 2.0;

if (QUANTIDADE_PARA_ALIVIAR <= 0) return 0;
return (float) _getVagoesVazios() / QUANTIDADE_PARA_ALIVIAR;]]></Body>
				</Function>
