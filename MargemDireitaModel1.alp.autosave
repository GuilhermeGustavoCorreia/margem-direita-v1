					</Parameter>
					<Body><![CDATA[if (!trace_dvs) return;
Log.info("GesDVs", "terminou_manobra", texto_trem(trem));
log_estado();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1797340000001</Id>
					<Name><![CDATA[segue_direto]]></Name>
					<X>50</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// segue direto para a saida: trem completo (82) ou celulose
Vagao v = trem.getPrimeiroVagao();
boolean celulose = (v != null && "celulose".equalsIgnoreCase(v.segmento));
return main().getNumeroDeVagoes(trem) >= TAMANHO_TREM_FORMADO || celulose;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797340000002</Id>
					<Name><![CDATA[iniciar_manobra]]></Name>
					<X>50</X><Y>630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// trem chegou nas DVs: decide se forma o trem de 82 ou estaciona
if (trem_em_manobra != null) {
    Log.warn("GesDVs", "manobra_simultanea", "ja existe trem em manobra: " + texto_trem(trem_em_manobra) + " | chegou: " + texto_trem(trem));
}
trem_em_manobra = trem;
linha_destino   = null;

Vagao v = trem.getPrimeiroVagao();
int acumulado = (v == null) ? 0 : acumulado_do_tipo(v.ferrovia, v.segmento);
formando = !segue_direto(trem) && acumulado > 0
        && acumulado + main().getNumeroDeVagoes(trem) == TAMANHO_TREM_FORMADO;

if (trace_dvs) {
    Log.info("GesDVs", "comecou_manobra", texto_trem(trem) + " | livre=" + espaco_livre()
        + " | acumulado do tipo=" + acumulado
        + " | " + (segue_direto(trem) ? "segue direto" : (formando ? "forma o trem de 82" : "estaciona")));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1797340000003</Id>
					<Name><![CDATA[escolher_linha]]></Name>
					<X>50</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// grava linha_destino e loga a decisao; chamada uma vez no onEnter do sel_acao
linha_destino = calcular_linha(trem);

if (linha_destino == null && !formando && main().getNumeroDeVagoes(trem) > 0) {
    Log.warn("GesDVs", "sem_linha", "nenhuma linha disponivel para " + texto_trem(trem) + " -> saida com os vagoes");
}
if (trace_dvs) {
    Log.info("GesDVs", "proxima_linha", texto_trem(trem) + " -> " + (linha_destino == null ? "saida" : linha_destino));
}
return linha_destino != null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1797340000015</Id>
					<Name><![CDATA[calcular_linha]]></Name>
					<X>50</X><Y>890</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// proxima linha do trem no ponto; null = vai para a saida
// sem efeito colateral: usada na condicao do sel_acao, que o AnyLogic avalia mais de uma vez
String[] linhas = { "DIR", "DV2", "DV3", "DV4" };
Vagao v = trem.getPrimeiroVagao();
int vagoes = main().getNumeroDeVagoes(trem);

if (formando) {
    // proxima linha com lote do mesmo tipo
    if (vagoes < TAMANHO_TREM_FORMADO) {
        for (String l : linhas) {
            if (mesmo_tipo(get_lote(l), v)) return l;
        }
    }
    return null;
}
if (vagoes == 0) return null;

// 1o: linha com lote do mesmo tipo e espaco; 2o: linha vazia
for (String l : linhas) {
    Trem lote = get_lote(l);
    if (mesmo_tipo(lote, v) && main().getNumeroDeVagoes(lote) < get_capacidade(l)) return l;
}
for (String l : linhas) {
    if (get_lote(l) == null) return l;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1797340000004</Id>
					<Name><![CDATA[mesmo_tipo]]></Name>
					<X>50</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lote]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[Vagao]]></Type>
					</Parameter>
					<Body><![CDATA[if (lote == null || v == null) return false;
return lote.getFerrovia().equalsIgnoreCase(v.ferrovia) && lote.getSegmento().equalsIgnoreCase(v.segmento);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Trem]]></ReturnType>
					<Id>1797340000005</Id>
					<Name><![CDATA[get_lote]]></Name>
					<X>50</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch (linha) {
    case "DIR": return lote_direita;
    case "DV2": return lote_dv2;
    case "DV3": return lote_dv3;
    case "DV4": return lote_dv4;
    default:    return null;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1797340000006</Id>
					<Name><![CDATA[get_capacidade]]></Name>
					<X>50</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (linha == null) {
    Log.warn("GesDVs", "linha_nula", "get_capacidade chamado sem linha_destino | trem em manobra: " + texto_trem(trem_em_manobra));
    return 0;
}
switch (linha) {
    case "DIR": return CAPACIDADE_DIREITA;
    case "DV2": return CAPACIDADE_DV2;
    case "DV3": return CAPACIDADE_DV3;
    case "DV4": return CAPACIDADE_DV4;
    default:    return 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RailwayTrack]]></ReturnType>
					<Id>1797340000007</Id>
					<Name><![CDATA[get_track_linha]]></Name>
					<X>50</X><Y>730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// trilho de cada linha das DVs
switch (linha) {
    case "DIR": return main().dv_direita;
    case "DV2": return main().dv_2;
    case "DV3": return main().dv_3;
    case "DV4": return main().dv_4_b;
    default:
        error("GestorDeDVs.get_track_linha: linha desconhecida '" + linha + "'");
        return null;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1797340000008</Id>
					<Name><![CDATA[get_offset_do_inicio]]></Name>
					<X>50</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// a ponta da Ponta da Praia e o inicio da track em dv_direita, dv_2 e dv_4_b; na dv_3 e o fim
return !"DV3".equals(linha);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RailwayTrack[]]]></ReturnType>
					<Id>1797340000009</Id>
					<Name><![CDATA[get_trilhos_evitar]]></Name>
					<X>50</X><Y>770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// linhas das DVs que a rota nao pode usar (todas, menos a de destino)
List<RailwayTrack> evitar = new ArrayList<RailwayTrack>();
for (String l : new String[] { "DIR", "DV2", "DV3", "DV4" }) {
    if (!l.equals(linha)) evitar.add(get_track_linha(l));
}
return evitar.toArray(new RailwayTrack[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797340000010</Id>
					<Name><![CDATA[entrar_lote_da_linha]]></Name>
					<X>50</X><Y>790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// o trem bateu no lote da linha: o lote entra no acoplar_lote
Trem lote = get_lote(linha_destino);
if (lote == null) {
    error("GestorDeDVs: trem bateu na linha " + linha_destino + " sem lote registrado");
    return;
}
entrar_lote.take(lote);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797340000011</Id>
					<Name><![CDATA[limpar_lote]]></Name>
					<X>50</X><Y>810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linha]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// lote acoplado no trem: a linha fica vazia ate o decouple deixar vagoes de novo
switch (linha) {
    case "DIR": lote_direita = null; break;
    case "DV2": lote_dv2     = null; break;
    case "DV3": lote_dv3     = null; break;
    case "DV4": lote_dv4     = null; break;
}
if (trace_dvs) {
    Log.info("GesDVs", "acoplou_lote", linha + " | trem agora: " + texto_trem(trem));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1797340000012</Id>
					<Name><![CDATA[n_vagoes_deixar]]></Name>
					<X>50</X><Y>830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// primeiros vagoes (lado da Ponta da Praia) que ficam na linha
return Math.min(get_capacidade(linha_destino), main().getNumeroDeVagoes(trem));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797340000013</Id>
					<Name><![CDATA[log_saida]]></Name>
					<X>50</X><Y>850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[int vagoes = main().getNumeroDeVagoes(trem);
String evento = vagoes >= TAMANHO_TREM_FORMADO ? "saida_82" : (vagoes == 0 ? "saida_loco" : "saida");
Log.info("GesDVs", evento, texto_trem(trem) + " -> circ_pos_fim_placa_2");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797340000014</Id>
					<Name><![CDATA[finalizar_manobra]]></Name>
					<X>50</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[log_terminou_manobra(trem);
trem_em_manobra = null;
linha_destino   = null;
formando        = false;
liberar_proxima_manobra();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1797340000016</Id>
					<Name><![CDATA[lote_do_tipo]]></Name>
					<X>240</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lote]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[segmento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (lote == null) return false;
return lote.getFerrovia().equalsIgnoreCase(ferrovia) && lote.getSegmento().equalsIgnoreCase(segmento);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1797340000017</Id>
					<Name><![CDATA[espaco_livre_tipo]]></Name>
					<X>240</X><Y>660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[segmento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// vagas que este tipo pode usar: linhas vazias + espaco nas linhas com lote do mesmo tipo
String[] linhas = { "DIR", "DV2", "DV3", "DV4" };
int total = 0;
for (String l : linhas) {
    Trem lote = get_lote(l);
    if (lote == null)                               total += get_capacidade(l);
    else if (lote_do_tipo(lote, ferrovia, segmento)) total += get_capacidade(l) - main().getNumeroDeVagoes(lote);
}
return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Trem]]></ReturnType>
					<Id>1797340000018</Id>
					<Name><![CDATA[lote_do_lider]]></Name>
					<X>240</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[segmento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[acumulado]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// lote de outro tipo com mais vagoes acumulados que este; null se nenhum passa deste acumulado
String[] linhas = { "DIR", "DV2", "DV3", "DV4" };
Trem lider = null;
int maior = acumulado;
for (String l : linhas) {
    Trem lote = get_lote(l);
    if (lote == null || lote_do_tipo(lote, ferrovia, segmento)) continue;
    int acum = acumulado_do_tipo(lote.getFerrovia(), lote.getSegmento());
    if (acum > maior) { maior = acum; lider = lote; }
}
return lider;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1797340000019</Id>
					<Name><![CDATA[espaco_lider_apos]]></Name>
					<X>240</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ferrovia]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[segmento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[vagoes]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ferrovia_lider]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[segmento_lider]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// simula estacionar 'vagoes' do tipo na mesma ordem do calcular_linha
// (1o linhas do tipo com espaco, 2o linhas vazias) e devolve o espaco que sobra para o lider
String[] linhas = { "DIR", "DV2", "DV3", "DV4" };
boolean[] usada = new boolean[linhas.length];
int resto = vagoes;

for (int i = 0; i < linhas.length && resto > 0; i++) {
    Trem lote = get_lote(linhas[i]);
    if (!lote_do_tipo(lote, ferrovia, segmento)) continue;
    int esp = get_capacidade(linhas[i]) - main().getNumeroDeVagoes(lote);
    resto -= Math.min(esp, resto);
}
for (int i = 0; i < linhas.length && resto > 0; i++) {
    if (get_lote(linhas[i]) != null) continue;
    usada[i] = true;   // linha passa a ter este tipo: o lider perde a linha inteira
    resto -= Math.min(get_capacidade(linhas[i]), resto);
}

int espaco = 0;
for (int i = 0; i < linhas.length; i++) {
    Trem lote = get_lote(linhas[i]);
    if (lote_do_tipo(lote, ferrovia_lider, segmento_lider)) espaco += get_capacidade(linhas[i]) - main().getNumeroDeVagoes(lote);
    else if (lote == null && !usada[i])                    espaco += get_capacidade(linhas[i]);
}
return espaco;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797400000501</Id>
					<Name><![CDATA[chegar_nas_dvs]]></Name>
					<Description><![CDATA[Entrada das DVs: entra se não há manobra, senão vai para fila_dvs]]></Description>
					<X>230</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// entrada das DVs: um trem manobra por vez; quem chega com manobra em andamento espera parado na entrada
if (trem_em_manobra == null && fila_dvs.isEmpty()) {
    entrarNasDVs.take(trem);
    return;
}
fila_dvs.add(trem);
Log.info("GesDVs", "aguardando_dvs", texto_trem(trem) + " | em manobra: " + texto_trem(trem_em_manobra) + " | fila=" + fila_dvs.size());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1797400000502</Id>
					<Name><![CDATA[liberar_proxima_manobra]]></Name>
					<Description><![CDATA[Manobra terminou: o primeiro da fila_dvs entra]]></Description>
					<X>230</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// manobra terminou: o primeiro da fila entra nas DVs
if (trem_em_manobra != null || fila_dvs.isEmpty()) return;
Trem t = fila_dvs.remove(0);
Log.info("GesDVs", "entra_da_fila", texto_trem(t) + " | fila=" + fila_dvs.size());
entrarNasDVs.take(t);]]></Body>
				</Function>
			</Functions>

