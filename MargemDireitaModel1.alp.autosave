					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[String nomeAgenteTerminal = getAgenteMoega(
	getDestinoDoTrem((Trem) agent)
);


Object blocoAgenteTerminal = getBlocoPeloNome(
	nomeAgenteTerminal, 
	this
);

Object blocoEnter = getBlocoPeloNome(
	"atendimento", 
	blocoAgenteTerminal
); 



try {
    java.lang.reflect.Method metodoTake = blocoEnter.getClass().getMethod(
        "take",
        Agent.class
    );

    metodoTake.invoke(blocoEnter, agent);

} catch (Exception e) {
    error("Erro ao chamar take() no bloco de atendimento: " + e.getMessage());
}]]></Code>
							</Value>
						</Parameter>
					</Parameters>
