						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-069: no alívio, o acoplar_b/a devolve a loco do alívio já engatada no lote
if ("b".equals(etapa_alivio)) {
	lote_vazios_b = null;
	alivio_seguir((Trem) agent);
} else if ("a".equals(etapa_alivio)) {
	lote_vazios_a = null;
	alivio_seguir((Trem) agent);
} else {
	chegou_vazios.take(agent);
}]]></Code>
							</Value>
						</Parameter>
					</Parameters>
