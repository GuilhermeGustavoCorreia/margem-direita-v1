			<Events>
				<Event>
					<Id>1795850000203</Id>
					<Name><![CDATA[ev_verificar_saida]]></Name>
					<X>300</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1795850000204</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1793952000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// a cada minuto: libera o trem da linha 02 quando o terminal puder receber
verificar_saida();]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1793876837451</Id>
					<Name><![CDATA[pode_estacionar]]></Name>
					<X>50</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// a linha 02 está livre quando não há trem reservado nela
return lote_linha02 == null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795840000218</Id>
					<Name><![CDATA[verificar_saida]]></Name>
					<Description><![CDATA[libera o trem da linha 02 quando o terminal puder receber; solta a vaga quando ele sai da linha. Chamada pelo evento ev_verificar_saida]]></Description>
					<X>300</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// chamada a cada minuto pelo evento ev_verificar_saida
// 1) trem já liberado: a vaga só é solta quando ele deixa todos os trechos da linha 02
if (saindo_linha02 != null) {
	if (!esta_na_linha02(saindo_linha02)) {
		Log.info("ISN", "saiu_linha02", String.format("trem=%d/%s saiu da linha 02: vaga livre", saindo_linha02.getId(), ((Trem) saindo_linha02).prefixo));
		saindo_linha02 = null;
		lote_linha02   = null;
	}
	return;
}
// 2) trem parado cujo terminal já pode receber e sem outro trem a caminho dele: libera
if (!parado_linha02 || lote_linha02 == null) return;

ITerminalMoega destino = lote_linha02.ITerminalMoega_destino;
boolean trem_a_caminho = false;
for (Trem t : main().gestorDeCirculacao.trens_em_circulacao) {
	if (t.ITerminalMoega_destino == destino) { trem_a_caminho = true; break; }
}
// a Chegadas pode ter acabado de despachar um trem direto para o mesmo terminal
Pedido p = main().gestorDeChegadas.pedido_atual;
if (p != null && "circulacao".equals(p.destino) && p.terminal == destino) trem_a_caminho = true;

// mesma regra de ferrovia/segmento do GestorDeChegadas, com o tipo real do trem parado
if (main().gestorDeChegadas.pode_receber_trem(destino, lote_linha02) && !trem_a_caminho) {
	main().gestorDeCirculacao.trens_em_circulacao.add(lote_linha02);
	Log.info("ISN", "liberado_linha02", String.format("trem=%d/%s liberado: %s pode receber", lote_linha02.getId(), ((Trem) lote_linha02).prefixo, ((Agent) lote_linha02.ITerminalMoega_destino).getName()));
	parado_linha02 = false;
	saindo_linha02 = lote_linha02;
	espera_linha02.free(lote_linha02);   // segue pelo sair_linha02 -> faixa da porteira
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1795840000219</Id>
					<Name><![CDATA[esta_na_linha02]]></Name>
					<Description><![CDATA[true se o trem ainda ocupa algum trecho isn_linha02_*]]></Description>
					<X>300</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// o trem ainda ocupa algum trecho isn_linha02_a..i?
RailwayTrack[] trechos = { main().isn_linha02_a, main().isn_linha02_b, main().isn_linha02_c,
	main().isn_linha02_d, main().isn_linha02_e, main().isn_linha02_f,
	main().isn_linha02_g, main().isn_linha02_h, main().isn_linha02_i };
for (RailwayTrack tr : trechos)
	if (tr.getTrains().contains(t)) return true;
return false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795850000201</Id>
					<Name><![CDATA[seguir_para_faixa]]></Name>
					<Description><![CDATA[define faixa_atual/proxima_faixa e entrega ao GestorDeCirculacao.tentar_usar_faixa]]></Description>
					<X>300</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[atual]]></Name>
						<Type><![CDATA[Faixa]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[proxima]]></Name>
						<Type><![CDATA[Faixa]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[bloco]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// define o par de faixas do trem e entrega ao mecanismo de licença do GestorDeCirculacao
// (tentar_usar_faixa licencia atual e próxima, libera as faixas já deixadas e chama atual.enter)
trem.faixa_atual   = atual;
trem.proxima_faixa = proxima;
Log.info("ISN", bloco, String.format("trem=%d/%s faixa_atual=%s proxima_faixa=%s", trem.getId(), ((Trem) trem).prefixo,
	atual   == null ? "null" : atual.recurso.getName(),
	proxima == null ? "null" : proxima.recurso.getName()));
main().gestorDeCirculacao.tentar_usar_faixa.take(trem);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795850000202</Id>
					<Name><![CDATA[registrar_faixas]]></Name>
					<Description><![CDATA[adiciona as faixas do ISN em gestorDeCirculacao.faixas (On startup)]]></Description>
					<X>300</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Log.iniciar(this);
// as faixas do ISN entram na lista do GestorDeCirculacao para que
// liberar_faixas_ocupadas() as libere quando o trem sair delas
List<Faixa> faixas_isn = java.util.List.of(faixa_isn_a, faixa_isn_b, faixa_isn_c, faixa_isn_d, faixa_isn_e, faixa_isn_porteira, faixa_isn_linha02_e);
for (Faixa f : faixas_isn)
	if (!main().gestorDeCirculacao.faixas.contains(f)) main().gestorDeCirculacao.faixas.add(f);
Log.info("ISN", "registrar_faixas", String.format("%d faixas registradas no GestorDeCirculacao", faixas_isn.size()));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Main]]></ReturnType>
					<Id>1793905848556</Id>
					<Name><![CDATA[main]]></Name>
					<X>60</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// acesso ao Main (mesmo padrão dos outros agentes)
return (Main) getEngine().getRoot();]]></Body>
				</Function>
			</Functions>

