							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("iniciar_alivio", agent, "entrou");
// ALT-062: alívio da Suzano. A loco da ferrovia chega (get_pos_alivio) e engata
// os vazios de L1 -> L2 -> L3 -> L4 e por último os 24 da L7000.
traceln(String.format("[%.1f][Suzano][iniciar_alivio] loco=%d | vazios=%d", time(), agent.getId(), _getVagoesVazios()));
alivio_vz_L1.take(loteVazios_L1);
alivio_vz_L2.take(loteVazios_L2);
alivio_vz_L3.take(loteVazios_L3);
alivio_vz_L4.take(loteVazios_L4);
alivio_vz_L7000.take(loteVazios_L7000);]]></Code>
							</Value>
						</Parameter>
