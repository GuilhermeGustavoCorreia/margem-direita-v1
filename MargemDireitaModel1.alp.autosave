qt_vgs_inicio_alivio = ((Trem) agent).getNumeroDeVagoes();
Log.info("ADM", "alivio_inicio", String.format("loco=%d chegou com %d vagoes | lote_linha_7=%d | quantidade_alivio=%d", agent.getId(), qt_vgs_inicio_alivio, main().getTamanhoDoTrem(lote_linha_7), quantidade_alivio));]]></Code>
