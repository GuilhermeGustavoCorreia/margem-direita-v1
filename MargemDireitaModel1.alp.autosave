					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792570000015</Id>
					<Name><![CDATA[liberar_wait_rp_moegaV]]></Name>
					<X>3050</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// solta o lote da moega V que espera a moega ficar livre (ou espaço na linha 7)
if (wait_rp_moegaV.size() > 0) {
    wait_rp_moegaV.free(wait_rp_moegaV.get(0));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792570000016</Id>
					<Name><![CDATA[linha7_tem_espaco]]></Name>
					<X>3050</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// cabe mais 1 vagão na linha 7? Conta o lote, os vagões a caminho e os que estão em descarga.
// Durante o alívio não tira vagão da moega.
if (alivio_linha7_em_andamento) return false;
int total = main().getTamanhoDoTrem(lote_linha_7) + vagoes_pendentes_linha7 + vagoes_em_descarga;
return total < CAPACIDADE_LINHA_7;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000201</Id>
					<Name><![CDATA[tentar_promover_segundo_lote]]></Name>
					<X>50</X><Y>400</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// solta o 2º lote (wait_segundo_lote_2000) para pegar a vaga da 2000 e virar emDescarga:
// mesma ferrovia e segmento: na hora (espera a vaga no ocupar_lote_em_descarga);
// tipo diferente: só com o terminal vazio (sem carregados e sem vazios), para não misturar ferrovias
if (wait_segundo_lote_2000.size() == 0) return;
Trem lote = (Trem) wait_segundo_lote_2000.get(0);

boolean mesmo_tipo = eh_mesmo_tipo_em_atendimento(lote);
if (!mesmo_tipo && !terminal_vazio_para_novo_tipo()) return;

Log.info("ADM", "segundo_lote", String.format("trem=%d promovido (mesmo_tipo=%b)", lote.getId(), mesmo_tipo));
wait_segundo_lote_2000.free(lote);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798200000202</Id>
					<Name><![CDATA[eh_mesmo_tipo_em_atendimento]]></Name>
					<X>50</X><Y>420</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// compara o 1º vagão do trem com a ferrovia/segmento em atendimento
for (int i = 0; i < trem.size(); i++) {
    Agent carro = trem.getCar(i);
    if (carro instanceof Vagao) {
        Vagao v = (Vagao) carro;
        return java.util.Objects.equals(v.ferrovia, ferrovia_em_atendimento)
            && java.util.Objects.equals(v.segmento, segmento_em_atendimento);
    }
}
return false;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798200000203</Id>
					<Name><![CDATA[terminal_vazio_para_novo_tipo]]></Name>
					<X>50</X><Y>440</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// sem carregados (fora o 2º lote), sem vazios na linha 7 e sem alívio em andamento
int carregados = _getVagoesCarregados() - main().getNumeroDeVagoes(lote_linha2000_proximo);
return lote_linha2000_emDescarga == null
    && carregados <= 0
    && _get_vagoes_vazios() == 0
    && vagoes_pendentes_linha7 == 0
    && vagoes_em_descarga == 0
    && !alivio_linha7_em_andamento;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798200000702</Id>
					<Name><![CDATA[lote_txt]]></Name>
					<X>4300</X><Y>100</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) return "-";
return t.getId() + ":" + main().getNumeroDeVagoes(t);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798200000703</Id>
					<Name><![CDATA[estado_resumo]]></Name>
					<X>4300</X><Y>140</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return String.format("vz=%d cg=%d ov=%.2f moega=%s", _getVagoesVazios(), _getVagoesCarregados(), getOverloadVazios(),
    "X=" + (rp_moegaX.idle() > 0 ? "livre" : "ocupada") + " V=" + (rp_moegaV.idle() > 0 ? "livre" : "ocupada"));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000704</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>4300</X><Y>180</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("ADM", evento, t + " | " + msg + " | " + estado_resumo());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798200000705</Id>
					<Name><![CDATA[log_estado]]></Name>
					<X>4300</X><Y>220</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// snapshot do terminal para o log de análise (idle/busy dos pools, tamanho dos waits)
if (!log_de_analise) return;
Log.info("ADM", "estado", estado_resumo());
Log.info("ADM", "estado_lotes", "lote_linha2000_emDescarga=" + lote_txt(lote_linha2000_emDescarga) +
    " lote_linha2000_proximo=" + lote_txt(lote_linha2000_proximo) +
    " lote_moegaX=" + lote_txt(lote_moegaX) +
    " lote_moegaV=" + lote_txt(lote_moegaV) +
    " lote_linha_7=" + lote_txt(lote_linha_7) +
    " _trem_chegando=" + lote_txt(_trem_chegando));
Log.info("ADM", "estado_pools", "linha2000_lote_em_descarga=" + linha2000_lote_em_descarga.idle() + "/" + linha2000_lote_em_descarga.busy() +
    " mnb_vazios=" + mnb_vazios.idle() + "/" + mnb_vazios.busy() +
    " mnb_carregados=" + mnb_carregados.idle() + "/" + mnb_carregados.busy() +
    " mnb_alivio=" + mnb_alivio.idle() + "/" + mnb_alivio.busy() +
    " rp_moegaX=" + rp_moegaX.idle() + "/" + rp_moegaX.busy() +
    " rp_moegaV=" + rp_moegaV.idle() + "/" + rp_moegaV.busy());
Log.info("ADM", "estado_waits", "wait_lote_linha2000=" + wait_lote_linha2000.size() +
    " wait_lote_linha_07=" + wait_lote_linha_07.size() +
    " wait_linha_moegaX=" + wait_linha_moegaX.size() +
    " wait_linha_moegaV=" + wait_linha_moegaV.size() +
    " wait_excesso_l7=" + wait_excesso_l7.size() +
    " wait_rp_moegaX=" + wait_rp_moegaX.size() +
    " wait_rp_moegaV=" + wait_rp_moegaV.size() +
    " wait_segundo_lote_2000=" + wait_segundo_lote_2000.size());]]></Body>
				</Function>
			</Functions>

