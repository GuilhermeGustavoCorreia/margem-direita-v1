// ALT-083: arquivos da interface HTML (pasta simulacao)
carregar_configuracao();
// ALT-084: duração da simulação (config/simulacao.csv) e chegadas de trens (input/tempo_entre_chegadas.csv)
getEngine().setStopTime(time() + toModelTime(duracao_h, HOUR));
traceln(String.format("[sim] simulação até %.1f h", duracao_h));
gestorDeChegadas.iniciar();]]></StartupCode>
