				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785153298380</Id>
					<Name><![CDATA[_estaDisponivelAlivio]]></Name>
					<X>1940</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int vaziosMar_a 	= main().getTamanhoDoTrem(_loteDeVazios_LinhaMar_a);
int vaziosMar_b 	= main().getTamanhoDoTrem(_loteDeVazios_LinhaMar_b);

int vaziosTerra_a 	= main().getTamanhoDoTrem(_loteDeVazios_LinhaTerra_a);
int vaziosTerra_b 	= main().getTamanhoDoTrem(_loteDeVazios_LinhaTerra_b);

int totaisVazios 	= (vaziosMar_a + vaziosMar_b + vaziosTerra_a + vaziosTerra_b);

int capacidadeTotal = (_CAPACIDADE_LINHA_MAR_A + _CAPACIDADE_LINHA_MAR_B + _CAPACIDADE_LINHA_TERRA_A + _CAPACIDADE_LINHA_TERRA_B);

if (capacidadeTotal > totaisVazios && !fazendoAlivio) 	aguardaAlivio.unblock();
else													aguardaAlivio.block();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795900000404</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>1940</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("CoperXI", evento, t + " | " + msg);]]></Body>
				</Function>
