							<Value Class="CodeValue">
								<Code><![CDATA[log_analise("descarga_moega04", agent, "fim");
// vagao descarregado na moega 04
((Trem) agent).descarregar_vagoes(true, ((Trem) agent).getNumeroDeVagoes());
Log.info("TES", "descarga_04e5", String.format("vagao=%d descarregado, vai p/ fundo %d", agent.getId(), fundo_destino_04e5));
// ultimo vagao (o proprio lote) -> o lote so fica null depois de descarregar
if (agent == lote_linha_5) {
    lote_linha_5 = null;
    Log.info("TES", "descarga_04e5", "linha 05 descarregada");
}
if (agent == lote_linha_4) {
    lote_linha_4 = null;
    Log.info("TES", "descarga_04e5", "linha 04 descarregada");
}]]></Code>
