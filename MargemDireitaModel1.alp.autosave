				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[float]]></ReturnType>
					<Id>1787231640652</Id>
					<Name><![CDATA[getOverloadVazios]]></Name>
					<X>790</X><Y>-500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ALT-005: conta os lotes vazios (antes contava os carregados)
int tamanhoVazios = _getVagoesVazios();

int capacidadeVazios = (
	CAPACIDADE_LINHA_MAR +
	CAPACIDADE_LINHA_TERRA
);

if (tamanhoVazios >= capacidadeVazios) {
	return (float) 1.1;
} else {
	return (float) 0.0;
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787242578330</Id>
					<Name><![CDATA[takeAlivio]]></Name>
					<X>790</X><Y>-430</Y>
					<Label><X>10</X><Y>0</Y></Label>
