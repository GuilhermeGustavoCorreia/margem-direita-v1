						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// distancia (m) entre o carro do trem mais perto de _tes_linha03_fim e o ponto.
// _tes_moega_linha03 e _tes_linha03_fim estao na mesma track; o trem vem da moega para o fim.
// Se nenhum carro estiver na track do fim, retorna 0 (nao avanca).
PositionOnTrack fim   = main()._tes_linha03_fim;
PositionOnTrack moega = main()._tes_moega_linha03;
RailwayTrack track_fim = fim.getTrack();
double offset_fim = fim.getOffset(METER);
double sinal = (moega.getOffset(METER) >= offset_fim) ? 1 : -1; // sentido moega -> fim

double menor = Double.MAX_VALUE;
try {
    for (int i = 0; i < trem.size(); i++) {
        Agent carro = trem.getCar(i);
        java.lang.reflect.Method m_track  = carro.getClass().getMethod("getTrack", boolean.class);
        java.lang.reflect.Method m_offset = carro.getClass().getMethod("getOffset", boolean.class);
        for (boolean frente : new boolean[]{true, false}) {
            RailwayTrack track = (RailwayTrack) m_track.invoke(carro, frente);
            if (track == track_fim) {
                double offset = (double) m_offset.invoke(carro, frente);
                menor = Math.min(menor, sinal * (offset - offset_fim));
            }
        }
    }
} catch (Exception e) {
    error("distancia_ate_fim_linha03: " + e.getMessage());
    return 0;
}

if (menor == Double.MAX_VALUE) {
    Log.info("TES", "distancia_ate_fim_linha03", String.format("trem=%d sem carro na track do fim", trem.getId()));
    return 0;
}
return Math.max(0, menor);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792671400066</Id>
					<Name><![CDATA[get_fundo_destino]]></Name>
					<X>2200</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lote_carregado]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// qual lote de fundo recebe o proximo vazio: 5 = linha 05, 4 = linha 04, 0 = nenhum
if (cabe_no_fundo(lote_linha_05_fundo, CAPACIDADE_LINHA_05_FUNDO, main()._tes_linha05_fundo_fim, main()._tes_linha05_fundo_comeco))
    return 5;

// o fundo da 04 ocupa o mesmo espaco do lote_linha_4: so recebe com a linha 04 vazia
// (ou quando o vagao que vai sair agora e o ultimo do lote_linha_4)
boolean linha4_livre = (lote_linha_4 == null) || (lote_carregado == lote_linha_4 && lote_linha_4.size() <= 1);
if (linha4_livre && cabe_no_fundo(lote_linha_04_fundo, CAPACIDADE_LINHA_04_FUNDO, main()._tes_linha04_fim, main()._tes_linha04_comeco))
    return 4;

return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792671400067</Id>
					<Name><![CDATA[cabe_no_fundo]]></Name>
					<X>520</X><Y>920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lote]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[capacidade]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fim]]></Name>
						<Type><![CDATA[PositionOnTrack]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[comeco]]></Name>
						<Type><![CDATA[PositionOnTrack]]></Type>
					</Parameter>
					<Body><![CDATA[// o lote de fundo cresce a partir do comeco; o vazio entra ocupando 1 vagao a partir do fim.
// Cabe se nao passar da capacidade e se (vagoes do lote + 1) vagoes couberem entre fim e comeco.
int n = (lote == null) ? 0 : lote.size();
if (n >= capacidade) return false;
double espaco = Math.abs(comeco.getOffset(METER) - fim.getOffset(METER));
return (n + 1) * main().TAMANHO_VAGAO_GRAO <= espaco;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PositionOnTrack]]></ReturnType>
					<Id>1792671400068</Id>
					<Name><![CDATA[get_pos_fim_fundo]]></Name>
					<X>520</X><Y>940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return (fundo_destino_04e5 == 5) ? main()._tes_linha05_fundo_fim : main()._tes_linha04_fim;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PositionOnTrack]]></ReturnType>
					<Id>1792671400069</Id>
					<Name><![CDATA[get_pos_comeco_fundo]]></Name>
					<X>520</X><Y>960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return (fundo_destino_04e5 == 5) ? main()._tes_linha05_fundo_comeco : main()._tes_linha04_comeco;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792671400070</Id>
					<Name><![CDATA[get_offset_entrada_fundo]]></Name>
					<X>520</X><Y>980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// cabeca do vazio 1 vagao para dentro a partir do fim (o vagao fica entre fim e fim + 1 vagao),
// como no trainEnter1 da ADM. Depois ele anda ate o comeco ou ate bater no lote de fundo.
PositionOnTrack fim    = get_pos_fim_fundo();
PositionOnTrack comeco = get_pos_comeco_fundo();
double sinal = (comeco.getOffset(METER) >= fim.getOffset(METER)) ? 1 : -1;
return fim.getOffset(METER) + sinal * main().TAMANHO_VAGAO_GRAO;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792671400071</Id>
					<Name><![CDATA[liberar_wait_lote_fundo05]]></Name>
					<X>520</X><Y>1000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// solta o lote do fundo 05 (como liberar_wait_lote_linha_09 do T39)
if (wait_fundo_05.size() > 0) {
    wait_fundo_05.free(wait_fundo_05.get(0));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
