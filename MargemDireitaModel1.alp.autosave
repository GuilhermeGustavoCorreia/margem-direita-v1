							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-003.3: coperXI ou pera -> via2_c; reserva a seguinte (pera: entrada da pera; coperXI: via2_d)
boolean pera = ("coperXXI".equals(((Trem) agent).ITerminalMoega_destino.getName()) || "moegaoMar".equals(((Trem) agent).ITerminalMoega_destino.getName()) || "moegaoTerra".equals(((Trem) agent).ITerminalMoega_destino.getName()));
((Trem) agent).faixa_atual   = faixa_via2_c;
((Trem) agent).proxima_faixa = pera ? faixa_entrada_pera : faixa_via2_d;

tentar_usar_faixa.take(agent);]]></Code>
							</Value>
						</Parameter>
