				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795900000401</Id>
					<Name><![CDATA[log_mov]]></Name>
					<X>-300</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String ]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent ]]></Type>
					</Parameter>
					<Body><![CDATA[// acompanhamento dos movimentos no terminal: bloco, trem e linhas ocupadas
if (!(a instanceof Trem)) {
	Log.info("CostaLeite", evento, "agente=" + a);
	return;
}
Trem t = (Trem) a;
StringBuilder linhas = new StringBuilder();
try {
	for (Object o : t.getAllOccupiedTracks()) {
		if (linhas.length() > 0) linhas.append(",");
		linhas.append(((RailwayTrack) o).getName());
	}
} catch (Exception e) {
	linhas.append("?");
}
Log.info("CostaLeite", evento, String.format("(%s - %d) | %d vgs + %d loco | linhas=%s",
	t.prefixo, t.getId(), t.getNumeroDeVagoes(), t.getNumeroDeLocomotivas(), linhas));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798110000001</Id>
					<Name><![CDATA[texto_trem]]></Name>
					<X>-200</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) return "null";
return "(" + t.prefixo + " - " + t.getId() + ")";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1798110000002</Id>
					<Name><![CDATA[texto_estado]]></Name>
					<X>-200</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// recurso de manobra, vazios presos no wait, lotes esperando descarga e o vagao na moega
return String.format("rp=%d/%d | wait=%d | waitLotes=%d | emDescarga=%s",
	rp_manobrando_carregados.busy(), rp_manobrando_carregados.size(),
	wait.size(), waitLotesParaDescarga.size(), texto_trem(_loteEmDescarga));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1798110000003</Id>
					<Name><![CDATA[log_rp]]></Name>
					<X>-300</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[// log de Seize/Release/Wait: trem + estado do recurso de manobra
String trem = (a instanceof Trem) ? texto_trem((Trem) a) + " | " + ((Trem) a).getNumeroDeVagoes() + " vgs + " + ((Trem) a).getNumeroDeLocomotivas() + " loco" : "agente=" + a;
Log.info("CostaLeite", evento, trem + " | " + texto_estado());]]></Body>
				</Function>
			</Functions>

