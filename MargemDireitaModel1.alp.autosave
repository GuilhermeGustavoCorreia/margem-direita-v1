				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1793103253588</Id>
					<Name><![CDATA[get_recursos_loco_alivio]]></Name>
					<X>50</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// ALT-063: pools que a loco do alívio trouxe e ainda segura:
// linha 5000/6000 (ocupar_linha5000_6000) e as faixas do caminho (bloquear_faixas_pmc).
List<ResourcePool> pools = new ArrayList<ResourcePool>();
for (ResourcePool rp : main().gestorDeCirculacao.get_recursos_linha_5000_6000(trem)) pools.add(rp);
for (Faixa f : primeiro_alivio_faixas) {
	if (f != null && f.recurso != null && !pools.contains(f.recurso) && !trem.resourceUnitsOfPool(f.recurso).isEmpty()) pools.add(f.recurso);
}
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1796400000021</Id>
					<Name><![CDATA[log_analise]]></Name>
					<X>550</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[evento]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// log de análise: só escreve com log_de_analise = true
if (!log_de_analise) return;
String t = (a == null) ? "-" : String.valueOf(a.getId());
if (a instanceof Trem) {
	Trem tr = (Trem) a;
	t = String.format("trem=%d carros=%d vgs=%d locos=%d", tr.getId(), tr.size(), tr.getNumeroDeVagoes(), tr.getNumeroDeLocomotivas());
}
Log.info("Eldorado", evento, t + " | " + msg);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1798130000001</Id>
					<Name><![CDATA[get_faixas_circulacao_liberar]]></Name>
					<X>550</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// igual ao liberar_faixas_ocupadas do GestorDeCirculacao, mas a marginal_c e a linha6000_a
// ficam com o trem: o encoste do Eldorado manobra até a marginal_c (_eldorado_mnb_encoste).
// As duas são soltas no liberar_linha5000_6000 (get_recursos_fim_encoste).
GestorDeCirculacao gc = main().gestorDeCirculacao;
List<ResourcePool> pools = new ArrayList<ResourcePool>();
for (Faixa f : gc.faixas) {
	if (f == gc.faixa_marginal_c || f == gc.faixa_linha6000_a) continue;
	if (f.idTremLicenciado != trem.getId() || f.estado != Faixa.EstadoFaixa.OCUPADA) continue;
	if (!f.faixaEstaVazia()) continue;
	f.liberar();
	if (!trem.resourceUnitsOfPool(f.recurso).isEmpty() && !pools.contains(f.recurso)) pools.add(f.recurso);
}
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[]]]></ReturnType>
					<Id>1798130000002</Id>
					<Name><![CDATA[get_recursos_fim_encoste]]></Name>
					<X>550</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trem]]></Name>
						<Type><![CDATA[Trem]]></Type>
					</Parameter>
					<Body><![CDATA[// fim do encoste (loco deixou o último lote): solta a linha 5000/6000, o mnb_pcx
// e as faixas marginal_c e linha6000_a que o trem segurou durante as manobras.
GestorDeCirculacao gc = main().gestorDeCirculacao;
List<ResourcePool> pools = new ArrayList<ResourcePool>();
for (ResourcePool rp : gc.get_recursos_linha_5000_6000(trem)) pools.add(rp);
// fim do encoste: solta também o mnb_pcx (pego na circulação, antes da silosMuro_a)
for (ResourcePool rp : gc.get_recursos_mnb_pcx(trem)) pools.add(rp);
for (Faixa f : java.util.List.of(gc.faixa_marginal_c, gc.faixa_linha6000_a)) {
	if (f.idTremLicenciado == trem.getId()) f.liberar();
	if (!trem.resourceUnitsOfPool(f.recurso).isEmpty() && !pools.contains(f.recurso)) pools.add(f.recurso);
}
return pools.toArray(new ResourcePool[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1798160000002</Id>
					<Name><![CDATA[terminal_ocupado]]></Name>
					<X>550</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// trem a caminho deste terminal (já mandado para a circulação, ainda não chegou ao comecar_encoste)
for (Trem t : main().gestorDeCirculacao.trens_em_circulacao) {
	if (t.ITerminalMoega_destino == this) return true;
}
// trem entrando ou descarregando: do comecar_encoste até o 1º lote de vazios
// (a contagem de carregados ainda não existe)
if (_trem_chegando != null) return true;
// vazios no terminal (esperando ou em alívio)
return _getVagoesVazios() > 0;]]></Body>
				</Function>
			</Functions>

