								<Code><![CDATA[// a seguinte depende do destino (tgrao e bracell saem pela marginal_c)
boolean tgrao = "tgrao".equals(((Trem) agent).get_terminal_name())
             || "bracell".equals(((Trem) agent).get_terminal_name())
             || "eldorado".equals(((Trem) agent).get_terminal_name())
             || "suzano".equals(((Trem) agent).get_terminal_name());
((Trem) agent).faixa_atual   = faixa_silosMuro_a;
((Trem) agent).proxima_faixa = tgrao ? faixa_marginal_c : faixa_silosMuro_b;

if (trace_circulacao) Log.info("GesCirculacao", "exit_para_silosMuro_a", String.format("trem=%d faixa_atual=%s proxima_faixa=%s", agent.getId(), (((Trem) agent).faixa_atual == null ? "null" : ((Trem) agent).faixa_atual.recurso.getName()), (((Trem) agent).proxima_faixa == null ? "null" : ((Trem) agent).proxima_faixa.recurso.getName())));
tentar_usar_faixa.take(agent);]]></Code>
