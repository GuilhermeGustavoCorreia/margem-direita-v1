							<Value Class="CodeValue">
								<Code><![CDATA[// ALT-073: o Wait é solto para emprestar a loco ou para começar a descarga
if ("loco".equals(destino_segunda_parte)) {
	destino_segunda_parte = "";
	entrar_tirar_loco.take(agent);
} else {
	destino_segunda_parte = "";
	entrar_moega.take(agent);
}]]></Code>
